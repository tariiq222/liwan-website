---
import Base from '../layouts/Base.astro';
import PagePlaceholder from '../components/PagePlaceholder.astro';
import { formatMoney, getPricing } from '../lib/pricing';
import { localePath, t, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'page.pricing');
const pricing = await getPricing();
const money = (amount: number) => formatMoney(locale, amount, pricing?.currency ?? 'SAR');
---

<Base locale={locale} title={title} path="/pricing/">
	<PagePlaceholder locale={locale} title={title} pageKey="pricing" />
	<div class="container prices">
		{
			pricing ? (
				<ul>
					{pricing.apps.map((app) => (
						<li>
							{locale === 'ar' ? app.name_ar : app.name_en}: {money(app.monthly)} {t(locale, 'pricing.monthly')}, {money(app.annual)} {t(locale, 'pricing.annual')}
						</li>
					))}
					<li>
						{t(locale, 'pricing.extraUser')}: {money(pricing.extra_user.monthly)} {t(locale, 'pricing.monthly')}
					</li>
					<li>
						{t(locale, 'pricing.extraStorage')} ({pricing.extra_storage.block_gb} GB): {money(pricing.extra_storage.block_monthly)} {t(locale, 'pricing.monthly')}
					</li>
					<li>
						{t(locale, 'pricing.onboarding')}: {money(pricing.onboarding.one_time)}
					</li>
				</ul>
			) : (
				<p>
					<a href={localePath(locale, '/contact')}>{t(locale, 'pricing.unavailable')}</a>
				</p>
			)
		}
	</div>
</Base>

<style>
	.prices {
		padding-bottom: 2rem;
	}
</style>
