---
// «كم تدفع في السنة؟» The visitor types the number of employees and what they pay a year for each
// tool they use (empty = not used). The Liwan side reads only the pricing object (annual prices);
// nothing here knows a price. The arithmetic is in src/scripts/apps-calc.ts. With no pricing, or
// above the user limit, the section says «تواصل معنا» instead of numbers.
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import { claim } from '../../config/claims';
import { priceKey } from '../../lib/app-price';
import { getPricing } from '../../lib/pricing';
import { localePath, t } from '../../i18n';

// Each tool the visitor may pay for maps to one Liwan application.
const TOOLS = [
	{ key: 'crm', label: 'أداة العملاء' },
	{ key: 'inbox', label: 'أداة رسائل العملاء أو واتساب' },
	{ key: 'tasks', label: 'أداة المهام' },
	{ key: 'meetings', label: 'أداة الاجتماعات' },
	{ key: 'chat', label: 'أداة محادثات الفريق' },
	{ key: 'documents', label: 'أداة المستندات' },
	{ key: 'operations', label: 'أداة الطلبات والموافقات' },
];

const platform = t('ar', 'brand.platform');
const contact = localePath('ar', '/contact/');
const pricing = await getPricing();
const apps = await getCollection('apps', ({ data }) => data.status !== 'hidden');
const bySlug = new Map(apps.map((entry) => [entry.data.slug, entry.data]));

// A paid application whose price is missing stays in the list with a contact note: the visitor's
// number for it cannot be compared, so the totals ask them to get in touch.
const tools = TOOLS.flatMap((tool) => {
	const data = bySlug.get(tool.key);
	if (!data || data.status !== 'available') return [];
	const paid = data.plan === 'paid';
	const price = paid ? pricing?.apps.find((app) => app.key === priceKey(data.featureKey)) : undefined;
	return [{ ...tool, appName: data.name.ar, paid, annual: price?.annual }];
});

const data = pricing && {
	currency: pricing.currency,
	freeUsers: pricing.free.users,
	maxUsers: pricing.extra_user.max_users,
	extraUserAnnual: pricing.extra_user.annual,
	storageGb: pricing.free.storage_gb,
	hosting: claim('saudiHosting') === 'available',
	tools: tools.map(({ key, appName, paid, annual }) => ({ key, appName, paid, annual })),
};
---

<Section
	id="calculator"
	eyebrow="الحاسبة"
	title="كم تدفع في السنة؟"
	lead={data ? 'اكتب ما تدفعه سنويًا لكل أداة تستخدمها، واترك ما لا تستخدمه فارغًا.' : undefined}
>
	{
		data ? (
			<div class="calc" data-year-calc>
				<script is:inline type="application/json" data-calc-data set:html={JSON.stringify(data)} />
				<label class="employees gradient-border">
					<span>كم موظفًا في شركتك؟</span>
					<input type="number" inputmode="numeric" min="1" step="1" value="5" data-employees />
				</label>

				<div class="tools">
					{tools.map((tool) => (
						<label class="tool card">
							<span class="tool-name">{tool.label}</span>
							<span class="tool-map">يقابلها في {platform}: {tool.appName}</span>
							{tool.paid && tool.annual === undefined && <span class="tool-map">سعره: تواصل معنا</span>}
							<span class="field">
								<input type="text" inputmode="decimal" placeholder="0" autocomplete="off" data-tool={tool.key} aria-label={`${tool.label}: ما تدفعه في السنة`} />
								<span class="unit">{data.currency === 'SAR' ? 'ر.س / سنة' : `${data.currency} / سنة`}</span>
							</span>
						</label>
					))}
				</div>

				<div class="contact card" data-contact hidden>
					<p>لحساب هذا الرقم بدقة، تواصل معنا.</p>
					<a class="button" href={contact}>تواصل معنا</a>
				</div>

				<div class="results" data-results>
					<div class="result card">
						<span class="r-label">تدفع اليوم في السنة</span>
						<strong data-today aria-live="polite">—</strong>
					</div>
					<div class="result card liwan">
						<span class="r-label">مع {platform} في السنة</span>
						<strong data-liwan aria-live="polite">—</strong>
						<ul class="counted" data-counted />
					</div>
					<div class="result card diff" data-diff-card>
						<span class="r-label" data-diff-label>الفرق في السنة</span>
						<strong data-diff aria-live="polite">—</strong>
					</div>
				</div>
				<p class="note" data-note>رسوم ميتا خارج الحسابين.</p>

				<div class="extras">
					<h3>ومع {platform} تحصل أيضًا على</h3>
					<ul data-extras-list />
				</div>
			</div>
		) : (
			<div class="fallback card">
				<p>للسعر المناسب لشركتك، تواصل معنا.</p>
				<a class="button" href={contact}>تواصل معنا</a>
			</div>
		)
	}
</Section>

<script>
	import '../../scripts/apps-calc';
</script>

<style>
	.calc {
		display: grid;
		gap: var(--space-6);
	}
	.employees {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-6);
		border-radius: var(--radius-lg);
		font-weight: 700;
		max-width: 420px;
	}
	input {
		font: inherit;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0.5rem 0.75rem;
		min-height: 44px;
		width: 100%;
		min-width: 0;
		text-align: start;
	}
	.employees input {
		width: 6rem;
	}
	.tools {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--space-4);
	}
	.tool {
		display: grid;
		gap: var(--space-1);
		cursor: text;
	}
	.tool-name {
		font-weight: 700;
	}
	.tool-map {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.field {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-2);
	}
	.unit {
		color: var(--text-muted);
		font-size: var(--text-sm);
		white-space: nowrap;
	}
	.results {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		align-items: start;
	}
	.result {
		display: grid;
		gap: var(--space-2);
	}
	.r-label {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.result strong {
		font-size: var(--text-2xl);
	}
	.liwan {
		border-color: var(--accent);
	}
	.diff.save strong {
		color: var(--success-text);
	}
	.diff.more strong {
		color: var(--warning-text);
	}
	.counted {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}
	.note {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.contact,
	.fallback {
		display: grid;
		justify-items: start;
		gap: var(--space-4);
	}
	.contact[hidden],
	.results[hidden],
	.note[hidden] {
		display: none;
	}
	.extras {
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--surface-muted);
		border: 1px solid var(--border);
	}
	.extras h3 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-3);
	}
	.extras ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--space-2) var(--space-6);
	}
	/* The items are created by the calculator script, so the scoped selector must reach them. */
	.extras ul :global(li)::before {
		content: '✓';
		color: var(--success);
		margin-inline-end: var(--space-2);
		font-weight: 700;
	}
	@media (max-width: 820px) {
		.results {
			grid-template-columns: 1fr;
		}
	}
</style>
