---
// «كم تدفع في السنة؟» The visitor types the number of employees and what they pay a year for each
// tool they use (empty = not used). The Liwan side reads only the pricing object (annual prices);
// nothing here knows a price. The arithmetic is in src/scripts/apps-calc.ts. With no pricing the
// section shows «تواصل معنا» instead.
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import { claim } from '../../config/claims';
import { getPricing } from '../../lib/pricing';
import { priceKey } from './app-pages';
import { localePath } from '../../i18n';

// Each tool the visitor may pay for maps to one Liwan application.
const TOOLS = [
	{ key: 'crm', label: 'أداة العملاء' },
	{ key: 'inbox', label: 'أداة رسائل العملاء أو واتساب' },
	{ key: 'tasks', label: 'أداة المهام' },
	{ key: 'meetings', label: 'أداة الاجتماعات' },
	{ key: 'chat', label: 'أداة محادثات الفريق' },
	{ key: 'documents', label: 'أداة المستندات' },
	{ key: 'operations', label: 'أداة الطلبات والموافقات' },
];

const pricing = await getPricing();
const apps = await getCollection('apps', ({ data }) => data.status !== 'hidden');
const bySlug = new Map(apps.map((entry) => [entry.data.slug, entry.data]));

const tools = TOOLS.flatMap((tool) => {
	const data = bySlug.get(tool.key);
	if (!data || data.status !== 'available') return [];
	if (data.plan === 'paid') {
		const price = pricing?.apps.find((app) => app.key === priceKey(data.featureKey));
		if (!price) return [];
		return [{ ...tool, appName: data.name.ar, annual: price.annual }];
	}
	return [{ ...tool, appName: data.name.ar }];
});

const data = pricing && {
	currency: pricing.currency,
	freeUsers: pricing.free.users,
	maxUsers: pricing.extra_user.max_users,
	extraUserAnnual: pricing.extra_user.annual,
	storageGb: pricing.free.storage_gb,
	hosting: claim('saudiHosting') === 'available',
	tools,
};
---

<Section id="calculator" eyebrow="الحاسبة" title="كم تدفع في السنة؟" lead="اكتب ما تدفعه سنويًا لكل أداة تستخدمها، واترك ما لا تستخدمه فارغًا.">
	{
		data ? (
			<div class="calc" data-year-calc>
				<script is:inline type="application/json" data-calc-data set:html={JSON.stringify(data)} />
				<label class="employees gradient-border">
					<span>كم موظفًا في شركتك؟</span>
					<input type="number" inputmode="numeric" min="1" max={data.maxUsers} value="5" data-employees />
				</label>

				<div class="tools">
					{tools.map((tool) => (
						<label class="tool card">
							<span class="tool-name">{tool.label}</span>
							<span class="tool-map">يقابلها في ليوان: {tool.appName}</span>
							<span class="field">
								<input type="text" inputmode="decimal" placeholder="٠" autocomplete="off" data-tool={tool.key} aria-label={`${tool.label}: ما تدفعه في السنة`} />
								<span class="unit">{data.currency === 'SAR' ? 'ر.س / سنة' : `${data.currency} / سنة`}</span>
							</span>
						</label>
					))}
				</div>

				<div class="results" aria-live="polite">
					<div class="result card">
						<span class="r-label">تدفع اليوم في السنة</span>
						<strong data-today>—</strong>
					</div>
					<div class="result card liwan">
						<span class="r-label">مع منصة ليوان في السنة</span>
						<strong data-liwan>—</strong>
						<ul class="counted" data-counted />
					</div>
					<div class="result card diff" data-diff-card>
						<span class="r-label" data-diff-label>الفرق في السنة</span>
						<strong data-diff>—</strong>
					</div>
				</div>
				<p class="note">رسوم ميتا خارج الحسابين.</p>

				<div class="extras" data-extras hidden>
					<h3>ومع ليوان تحصل أيضًا على</h3>
					<ul data-extras-list />
				</div>
			</div>
		) : (
			<div class="fallback card">
				<p>للسعر المناسب لشركتك، تواصل معنا.</p>
				<a class="button" href={localePath('ar', '/contact/')}>تواصل معنا</a>
			</div>
		)
	}
</Section>

<script>
	import '../../scripts/apps-calc';
</script>

<style>
	.calc {
		display: grid;
		gap: var(--space-6);
	}
	.employees {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-6);
		border-radius: var(--radius-lg);
		font-weight: 700;
		max-width: 420px;
	}
	input {
		font: inherit;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0.5rem 0.75rem;
		min-height: 44px;
		width: 100%;
		min-width: 0;
		text-align: start;
	}
	.employees input {
		width: 6rem;
	}
	.tools {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--space-4);
	}
	.tool {
		display: grid;
		gap: var(--space-1);
		cursor: text;
	}
	.tool-name {
		font-weight: 700;
	}
	.tool-map {
		color: var(--text-muted);
		font-size: var(--text-sm);
		margin-bottom: var(--space-2);
	}
	.field {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.unit {
		color: var(--text-muted);
		font-size: var(--text-sm);
		white-space: nowrap;
	}
	.results {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		align-items: start;
	}
	.result {
		display: grid;
		gap: var(--space-2);
	}
	.r-label {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.result strong {
		font-size: var(--text-2xl);
	}
	.liwan {
		border-color: var(--accent);
	}
	.diff.save strong {
		color: var(--success-text);
	}
	.diff.more strong {
		color: var(--warning-text);
	}
	.counted {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}
	.note {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.extras {
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--gradient-sand);
		border: 1px solid var(--border);
	}
	.extras h3 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-3);
	}
	.extras ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--space-2) var(--space-6);
	}
	.extras li::before {
		content: '✓';
		color: var(--success);
		margin-inline-end: var(--space-2);
		font-weight: 700;
	}
	.fallback {
		display: grid;
		justify-items: start;
		gap: var(--space-4);
	}
	@media (max-width: 820px) {
		.results {
			grid-template-columns: 1fr;
		}
	}
</style>
