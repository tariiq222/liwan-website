---
// A small decorative window drawn in CSS, like the mocks on the home page. The labels are
// illustrative text; the window is hidden from assistive technology.
import type { MockKind } from './app-pages';

interface Props {
	kind: MockKind;
	labels: string[];
}

const { kind, labels } = Astro.props;
const bars = [72, 48, 86];
---

<div class="mock" aria-hidden="true">
	<div class="bar"><i></i><i></i><i></i></div>
	<div class={`body ${kind}`}>
		{
			kind === 'board' && (
				<div class="cols">
					{labels.map((label, c) => (
						<div class="col">
							<span class="head">{label}</span>
							{Array.from({ length: c === 1 ? 2 : c === 0 ? 2 : 1 }, () => (
								<div class="mini">
									<span class="line long" />
									<span class="line short" />
								</div>
							))}
						</div>
					))}
				</div>
			)
		}
		{
			(kind === 'rows' || kind === 'versions') &&
				labels.map((label, i) => (
					<div class="row">
						<span class="dot" />
						<span class="text">{label}</span>
						{kind === 'versions' ? <span class="chip">{`إصدار ${i + 1}`}</span> : i === 0 && <span class="chip">الآن</span>}
					</div>
				))
		}
		{
			kind === 'steps' &&
				labels.map((label, i) => (
					<div class:list={['step', { done: i === 0 }]}>
						<span class="tick">{i === 0 ? '✓' : ''}</span>
						<span class="text">{label}</span>
					</div>
				))
		}
		{
			(kind === 'bubbles' || kind === 'chat') && (
				<div class="talk">
					{labels.map((label, i) => (
						<div class:list={['bubble', { mine: i % 2 === 1 }]}>{label}</div>
					))}
					{kind === 'chat' && <span class="approve">موافق</span>}
				</div>
			)
		}
		{
			kind === 'stats' && (
				<div class="stats">
					{labels.map((label, i) => (
						<div class="stat">
							<span class="stat-name">{label}</span>
							<span class="meter">
								<b style={`width: ${bars[i % bars.length]}%`} />
							</span>
						</div>
					))}
				</div>
			)
		}
		{
			kind === 'cal' && (
				<div class="week">
					{labels.map((label, i) => (
						<div class="day">
							<span class="event" style={`margin-top: ${i * 14}px`}>{label}</span>
						</div>
					))}
					<div class="day"><span class="line long" /></div>
				</div>
			)
		}
	</div>
</div>

<style>
	.mock {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		min-width: 0;
	}
	.bar {
		display: flex;
		gap: 5px;
		padding: 0.6rem 0.8rem;
		background: var(--surface-sunken);
		border-bottom: 1px solid var(--border);
	}
	.bar i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--border-strong);
	}
	.body {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4);
		min-height: 150px;
		align-content: center;
	}
	.line {
		display: block;
		height: 6px;
		border-radius: 3px;
		background: var(--border-strong);
	}
	.line.long {
		width: 85%;
	}
	.line.short {
		width: 50%;
		margin-top: 6px;
	}
	.cols {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-2);
	}
	.col {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		padding: var(--space-2);
		border-radius: var(--radius-sm);
		background: var(--surface-sunken);
	}
	.head {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--text-muted);
	}
	.mini {
		padding: var(--space-2);
		border-radius: var(--radius-sm);
		background: var(--surface);
		border: 1px solid var(--border);
	}
	.row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.5rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: var(--text-sm);
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		flex-shrink: 0;
	}
	.text {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.chip {
		padding: 0 0.6rem;
		border-radius: var(--radius-full);
		background: var(--accent-soft);
		color: var(--accent);
		font-size: var(--text-xs);
		font-weight: 600;
		white-space: nowrap;
	}
	.step {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}
	.tick {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 2px solid var(--border-strong);
		font-size: 12px;
		color: var(--on-accent);
		flex-shrink: 0;
	}
	.step.done .tick {
		background: var(--success);
		border-color: var(--success);
	}
	.talk {
		display: grid;
		gap: var(--space-2);
		justify-items: start;
	}
	.bubble {
		max-width: 88%;
		padding: 0.5rem 0.8rem;
		border-radius: var(--radius);
		background: var(--surface-sunken);
		font-size: var(--text-sm);
	}
	.bubble.mine {
		justify-self: end;
		background: var(--accent-soft);
		color: var(--text);
	}
	.approve {
		justify-self: end;
		padding: 0.15rem 1rem;
		border-radius: var(--radius-full);
		background: var(--accent);
		color: var(--on-accent);
		font-size: var(--text-xs);
		font-weight: 600;
	}
	.stats {
		display: grid;
		gap: var(--space-3);
	}
	.stat {
		display: grid;
		gap: 4px;
		font-size: var(--text-sm);
	}
	.meter {
		display: block;
		height: 8px;
		border-radius: 4px;
		background: var(--surface-sunken);
		overflow: hidden;
	}
	.meter b {
		display: block;
		height: 100%;
		border-radius: 4px;
		background: var(--gradient-accent);
	}
	.week {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-2);
		align-items: start;
	}
	.day {
		min-height: 90px;
		padding: 6px;
		border-radius: var(--radius-sm);
		background: var(--surface-sunken);
	}
	.event {
		display: block;
		padding: 4px 6px;
		border-radius: 6px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: var(--text-xs);
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
