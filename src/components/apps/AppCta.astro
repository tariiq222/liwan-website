---
// Closing call to action for the application pages: the lavender band used by the home page.
import Mark from '../Mark.astro';
import { loginUrl, registerUrl } from '../../lib/links';

interface Props {
	title: string;
	line: string;
	button: string;
}

const { title, line, button } = Astro.props;
---

<section class="closing">
	<div class="container inner">
		<div class="mark" data-reveal="fade"><Mark size={88} inverted animated /></div>
		<h2 data-reveal style="--i: 1">{title}</h2>
		<p data-reveal style="--i: 2">{line}</p>
		<div class="actions" data-reveal style="--i: 3">
			<a class="button large white" href={registerUrl('ar')} data-app-link>{button}</a>
			<a class="button large secondary outline" href={loginUrl('ar')} data-app-link>تسجيل الدخول</a>
		</div>
	</div>
</section>

<style>
	.closing {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(4rem, 3rem + 5vw, 7rem);
		background: var(--gradient-brand);
		color: #fff;
		text-align: center;
	}
	.inner {
		display: grid;
		justify-items: center;
		gap: var(--space-4);
	}
	h2 {
		font-size: var(--text-3xl);
		max-width: 22ch;
	}
	p {
		font-size: var(--text-lg);
		opacity: 0.9;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}
	.button.white:not(.secondary):not(.ghost) {
		background: #fff;
		color: var(--lavender-800);
		box-shadow: 0 10px 28px -10px rgb(20 16 42 / 0.5);
	}
	.button.white:not(.secondary):not(.ghost):hover {
		background: var(--sand-50);
	}
	.button.outline {
		border-color: rgb(255 255 255 / 0.7);
		color: #fff;
	}
	.button.outline:hover {
		border-color: #fff;
		background: rgb(255 255 255 / 0.12);
		color: #fff;
	}
	@media (max-width: 560px) {
		.actions .button {
			flex: 1 1 100%;
		}
	}
</style>
