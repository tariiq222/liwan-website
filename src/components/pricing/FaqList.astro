---
// A framed column of questions. `<details name>` keeps one answer open at a time without script.
// Shared by /pricing and /security.
import Icon from '../Icon.astro';

interface Props {
	items: { q: string; a: string }[];
	group: string;
}
const { items, group } = Astro.props;
---

<div class="faq-frame" data-reveal>
	{
		items.map((item, i) => (
			<details name={group} open={i === 0}>
				<summary>
					<span>{item.q}</span>
					<Icon name="chevron-down" size={20} />
				</summary>
				<div class="answer"><p>{item.a}</p></div>
			</details>
		))
	}
</div>

<style>
	.faq-frame {
		overflow: hidden;
		max-width: 760px;
		margin-inline: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}
	details + details {
		border-top: 1px solid var(--border);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 68px;
		padding: var(--space-3) var(--space-6);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		transition: background var(--duration) var(--ease);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		background: var(--accent-soft);
	}
	summary:focus-visible {
		outline-offset: -3px;
	}
	summary :global(svg) {
		flex-shrink: 0;
		color: var(--accent);
		transition: transform var(--duration) var(--ease);
	}
	details[open] summary :global(svg) {
		transform: rotate(180deg);
	}
	.answer {
		padding: 0 var(--space-6) var(--space-6);
		color: var(--text-muted);
	}
	@media (max-width: 560px) {
		summary,
		.answer {
			padding-inline: var(--space-4);
		}
	}
</style>
