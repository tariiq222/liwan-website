---
// The full subscription calculator: controls on one side, a summary with a line-by-line breakdown
// on the other. The arithmetic lives in src/scripts/pricing-format.ts and runs in the browser via
// src/scripts/pricing-calculator.ts, which finds everything through the data- attributes below.
import Icon from '../Icon.astro';
import { formatMoney, type Pricing } from '../../lib/pricing';
import { storageLabel, usersLabel } from '../../scripts/pricing-format';
import { localePath } from '../../i18n';
import { registerUrl } from '../../lib/links';

interface Props {
	pricing: Pricing;
	appNames: Record<string, string>;
}

const { pricing, appNames } = Astro.props;
const money = (amount: number) => formatMoney('ar', amount, pricing.currency);
const contact = localePath('ar', '/contact');
const nameOf = (key: string) => appNames[key];
---

<div class="calc gradient-border" data-reveal>
	<div class="controls">
		<h2>احسب اشتراكك</h2>

		<fieldset class="group">
			<legend>التطبيقات</legend>
			<div class="app-options">
			{
				pricing.apps.map((app) => (
					<label class="option">
						<input type="checkbox" data-app value={app.key} />
						<span class="option-name">{nameOf(app.key)}</span>
						<span class="option-price">
							<span data-price-app={app.key}>{money(app.monthly)}</span> <span data-period-word>شهريًا</span>
						</span>
					</label>
				))
			}
			</div>
		</fieldset>

		<div class="limits-row">
		<div class="group">
			<div class="group-head">
				<label for="calc-users">المستخدمون</label>
				<output for="calc-users" data-users-out>{usersLabel(pricing.free.users)}</output>
			</div>
			<input id="calc-users" type="range" min={pricing.free.users} max={pricing.extra_user.max_users} step="1" value={pricing.free.users} data-users />
			<p class="hint">
				أول {usersLabel(pricing.free.users)} مجانًا، وكل مستخدم إضافي <span data-price-user>{money(pricing.extra_user.monthly)}</span>{' '}
				<span data-period-word>شهريًا</span>
			</p>
			<p class="hint" data-users-max hidden>فريق أكبر من هذا؟ <a href={contact}>تواصل معنا</a></p>
		</div>

		<div class="group">
			<div class="group-head"><span id="calc-storage-label">التخزين</span></div>
			<div class="stepper" role="group" aria-labelledby="calc-storage-label">
				<button type="button" class="step-btn" data-storage-down aria-label="تقليل التخزين"><span class="minus"></span></button>
				<output data-storage-out aria-live="polite">{storageLabel(pricing.free.storage_gb)}</output>
				<button type="button" class="step-btn" data-storage-up aria-label="زيادة التخزين"><Icon name="plus" size={18} strokeWidth={2.4} /></button>
			</div>
			<p class="hint">
				أول {storageLabel(pricing.free.storage_gb)} مجانًا، ثم كل {storageLabel(pricing.extra_storage.block_gb)}{' '}
				<span data-price-storage>{money(pricing.extra_storage.block_monthly)}</span> <span data-period-word>شهريًا</span>
			</p>
		</div>
		</div>

		<label class="option">
			<input type="checkbox" data-onboarding />
			<span class="option-name">إعداد مع فريقنا</span>
			<span class="option-price">{money(pricing.onboarding.one_time)} مرة واحدة</span>
		</label>
	</div>

	<div class="total" aria-live="polite">
		<p class="total-main">
			<span class="total-label">اشتراكك</span>
			<strong data-total>مجانًا</strong>
			<span data-period data-period-word hidden>شهريًا</span>
		</p>
		<ul class="breakdown">
			{
				pricing.apps.map((app) => (
					<li data-line-app={app.key} hidden>
						<span>{nameOf(app.key)}</span>
						<span data-amount></span>
					</li>
				))
			}
			<li data-line-users hidden><span>مستخدمون إضافيون <small data-qty></small></span><span data-amount></span></li>
			<li data-line-storage hidden><span>تخزين إضافي <small data-qty></small></span><span data-amount></span></li>
		</ul>
		<p class="saving" data-saving hidden>توفّر <strong data-saving-amount></strong> في السنة بالدفع السنوي</p>
		<p class="onboarding-line" data-onboarding-line hidden>
			<span>إعداد مع فريقنا، مرة واحدة</span>
			<strong data-onboarding-amount></strong>
		</p>
		<a class="button large" href={registerUrl('ar')} data-app-link>جرّب 14 يومًا مجانًا</a>
	</div>
</div>

<style>
	.calc {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: var(--space-8);
		align-items: start;
		padding: var(--space-8);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}
	.controls {
		display: grid;
		gap: var(--space-6);
		min-width: 0;
	}
	h2 {
		font-size: var(--text-2xl);
	}
	.group {
		display: grid;
		gap: var(--space-2);
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend,
	.group-head label,
	.group-head > span {
		padding: 0;
		font-weight: 600;
	}
	legend {
		margin-bottom: var(--space-2);
	}
	.group-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
	}
	output {
		color: var(--accent);
		font-weight: 700;
	}
	.hint {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.calc [hidden] {
		display: none;
	}
	input[type='range'] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 28px;
		margin: 0;
		background: transparent;
		cursor: pointer;
	}
	input[type='range']::-webkit-slider-runnable-track {
		height: 6px;
		border-radius: var(--radius-full);
		background: linear-gradient(to left, var(--accent) var(--fill, 0%), var(--border-strong) var(--fill, 0%));
	}
	input[type='range']::-moz-range-track {
		height: 6px;
		border-radius: var(--radius-full);
		background: linear-gradient(to left, var(--accent) var(--fill, 0%), var(--border-strong) var(--fill, 0%));
	}
	input[type='range']::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 22px;
		height: 22px;
		margin-top: -8px;
		border: 3px solid var(--surface);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 1px 4px rgb(20 16 42 / 0.3);
	}
	input[type='range']::-moz-range-thumb {
		width: 16px;
		height: 16px;
		border: 3px solid var(--surface);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 1px 4px rgb(20 16 42 / 0.3);
	}
	input[type='range']:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 4px;
	}
	.option {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-2);
		padding: var(--space-3) var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		cursor: pointer;
		transition:
			border-color var(--duration) var(--ease),
			background var(--duration) var(--ease);
	}
	.option:hover {
		border-color: var(--border-strong);
	}
	.option:has(input:checked) {
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.option input {
		width: 20px;
		height: 20px;
		accent-color: var(--accent);
	}
	.option-name {
		font-weight: 600;
	}
	.option-price {
		color: var(--text-muted);
		font-size: var(--text-sm);
		text-align: end;
	}
	.stepper {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.stepper output {
		min-width: 8rem;
		text-align: center;
		font-size: var(--text-lg);
	}
	.step-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
		transition:
			border-color var(--duration) var(--ease),
			color var(--duration) var(--ease);
	}
	.minus {
		width: 14px;
		height: 2.4px;
		border-radius: 2px;
		background: currentColor;
	}
	.step-btn:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.step-btn:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.total {
		position: sticky;
		top: calc(68px + var(--space-6));
		display: grid;
		gap: var(--space-3);
		padding: var(--space-6);
		border-radius: var(--radius);
		background: var(--surface-sunken);
	}
	.total-main {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
	}
	.total-label {
		margin-inline-end: auto;
		color: var(--text-muted);
	}
	.total-main strong {
		font-size: var(--text-3xl);
		line-height: 1.2;
	}
	.breakdown {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.breakdown li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.breakdown small {
		font-size: inherit;
	}
	.saving {
		color: var(--success-text);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.onboarding-line {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px dashed var(--border-strong);
		font-size: var(--text-sm);
	}
	.total .button {
		margin-top: var(--space-2);
	}
	@media (max-width: 900px) {
		.calc {
			grid-template-columns: minmax(0, 1fr);
		}
		.total {
			position: static;
		}
	}
	@media (max-width: 560px) {
		.calc {
			padding: var(--space-6) var(--space-4);
		}
		.option {
			grid-template-columns: auto 1fr;
		}
		.option-price {
			grid-column: 2;
			text-align: start;
		}
	}
	/* Applications: two per row; the price sits under the name. */
	.app-options {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2);
	}
	.app-options .option {
		grid-template-columns: auto 1fr;
		row-gap: 2px;
		margin-bottom: 0;
	}
	.app-options .option-price {
		grid-column: 2;
	}
	@media (max-width: 560px) {
		.app-options {
			grid-template-columns: 1fr;
		}
	}
	/* Users and storage side by side. */
	.limits-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		align-items: start;
	}
	@media (max-width: 640px) {
		.limits-row {
			grid-template-columns: 1fr;
		}
	}
</style>
