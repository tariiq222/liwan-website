---
// Site header: brand, main links, language switch, sign-in and the primary call to action.
// Below 900px the links collapse into a disclosure panel opened by the menu button.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { localePath, otherLocale, t, type Locale } from '../i18n';
import { loginUrl, registerUrl } from '../lib/links';

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const other = otherLocale(locale);
const links = [
	{ href: localePath(locale, '/apps'), label: t(locale, 'nav.apps') },
	{ href: localePath(locale, '/pricing'), label: t(locale, 'nav.pricing') },
	{ href: localePath(locale, '/security'), label: t(locale, 'nav.security') },
];
const current = localePath(locale, path);
---

<header class="site-header" data-header>
	<div class="container bar">
		<a class="brand" href={localePath(locale, '/')} aria-label={t(locale, 'brand.platform')}>
			<Mark size={30} />
			<span>{t(locale, 'brand.platform')}</span>
		</a>

		<nav class="links" aria-label={t(locale, 'nav.main')}>
			{links.map((l) => <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
		</nav>

		<div class="actions">
			<a class="lang" href={localePath(other, path)} hreflang={other} lang={other}>
				<Icon name="globe" size={16} />
				{t(locale, 'nav.language')}
			</a>
			<button
				class="icon-button theme-button"
				type="button"
				data-theme-toggle
				data-label-light={t(locale, 'theme.light')}
				data-label-dark={t(locale, 'theme.dark')}
				aria-label={t(locale, 'theme.dark')}
			>
				<Icon name="moon" size={18} class="to-dark" />
				<Icon name="sun" size={18} class="to-light" />
			</button>
			<a class="button small ghost login" href={loginUrl(locale)} data-app-link>{t(locale, 'cta.login')}</a>
			<a class="button small cta" href={registerUrl(locale)} data-app-link>{t(locale, 'cta.start')}</a>
			<button
				class="menu-button"
				type="button"
				aria-expanded="false"
				aria-controls="site-menu"
				data-menu-button
				data-label-open={t(locale, 'nav.menu')}
				data-label-close={t(locale, 'nav.close')}
				aria-label={t(locale, 'nav.menu')}
			>
				<Icon name="menu" class="when-closed" />
				<Icon name="x" class="when-open" />
			</button>
		</div>
	</div>

	<div class="menu-panel" id="site-menu" hidden data-menu-panel>
		<nav class="container" aria-label={t(locale, 'nav.main')}>
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
			<a href={loginUrl(locale)} data-app-link>{t(locale, 'cta.login')}</a>
			<a href={localePath(other, path)} hreflang={other} lang={other}>{t(locale, 'nav.language')}</a>
			<a class="button large" href={registerUrl(locale)} data-app-link>{t(locale, 'cta.start')}</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
	const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

	function setOpen(open: boolean): void {
		if (!button || !panel) return;
		button.setAttribute('aria-expanded', String(open));
		button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
		panel.hidden = !open;
		header?.classList.toggle('is-open', open);
	}

	button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			button.focus();
		}
	});
	window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});

	// Light/dark toggle. The page follows the device until the visitor picks a side; the choice
	// is kept in this browser only (applied before paint by the inline script in Base.astro).
	const root = document.documentElement;
	const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const isDark = () =>
		root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
	const labelTheme = () => {
		if (!themeButton) return;
		themeButton.setAttribute('aria-label', (isDark() ? themeButton.dataset.labelLight : themeButton.dataset.labelDark) ?? '');
	};
	labelTheme();
	themeButton?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('liwan-theme', next);
		} catch {
			// Storage can be blocked (private mode); the choice then lasts for this page only.
		}
		labelTheme();
	});

	// A hairline appears once the page scrolls under the header.
	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: saturate(1.4) blur(14px);
		-webkit-backdrop-filter: saturate(1.4) blur(14px);
		border-bottom: 1px solid transparent;
		transition: border-color var(--duration) var(--ease);
	}
	.site-header.is-scrolled,
	.site-header.is-open {
		border-bottom-color: var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		min-height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 700;
		font-size: 1.3rem;
		color: var(--text);
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: var(--space-1);
	}
	.links a {
		padding: 0.4rem 0.8rem;
		border-radius: var(--radius-sm);
		color: var(--text);
		text-decoration: none;
		transition: background var(--duration) var(--ease);
	}
	.links a:hover,
	.links a[aria-current='page'] {
		background: var(--surface-muted);
		color: var(--text);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-inline-start: auto;
	}
	.lang {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.6rem;
		color: var(--text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
	}
	.lang:hover {
		color: var(--text);
	}
	.icon-button {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--duration) var(--ease),
			border-color var(--duration) var(--ease);
	}
	.icon-button:hover {
		color: var(--text);
		border-color: var(--border-strong);
	}
	/* Show the moon on a light page and the sun on a dark one. */
	.theme-button :global(.to-light) {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-button :global(.to-light) {
		display: block;
	}
	:global(:root[data-theme='dark']) .theme-button :global(.to-dark) {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .theme-button :global(.to-light) {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .theme-button :global(.to-dark) {
			display: none;
		}
	}
	.menu-button {
		display: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
	}
	.menu-button :global(.when-open),
	.menu-button[aria-expanded='true'] :global(.when-closed) {
		display: none;
	}
	.menu-button[aria-expanded='true'] :global(.when-open) {
		display: block;
	}
	.menu-panel {
		border-top: 1px solid var(--border);
		padding-block: var(--space-4) var(--space-6);
	}
	.menu-panel nav {
		display: grid;
		gap: var(--space-1);
	}
	.menu-panel a:not(.button) {
		padding: var(--space-3) var(--space-2);
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-lg);
		border-bottom: 1px solid var(--border);
	}
	.menu-panel .button {
		margin-top: var(--space-4);
	}

	@media (max-width: 899px) {
		.links,
		.lang,
		.login {
			display: none;
		}
		.menu-button {
			display: grid;
		}
	}
	@media (max-width: 480px) {
		.cta {
			min-height: 40px;
			padding: 0.3rem 0.95rem;
			font-size: var(--text-sm);
		}
	}
</style>
