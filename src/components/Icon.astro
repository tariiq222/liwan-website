---
// One Lucide icon from src/brand/icons.ts. Decorative by default; pass `label` when the icon
// is the only content of a control.
import { ICONS, type IconName } from '../brand/icons';

interface Props {
	name: IconName;
	size?: number;
	strokeWidth?: number;
	label?: string;
	class?: string;
}

const { name, size = 20, strokeWidth = 1.75, label, class: className } = Astro.props;
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	set:html={ICONS[name]}
/>
