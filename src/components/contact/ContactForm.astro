---
// The only form on the site. It posts to the product (src/scripts/contact-form.ts); the Turnstile
// site key comes from PUBLIC_TURNSTILE_SITE_KEY. Without a key the form is shown disabled.
import Icon from '../Icon.astro';
import { localePath } from '../../i18n';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const ready = Boolean(siteKey);
---

<div class="card form-card">
	<form data-contact novalidate data-sitekey={siteKey}>
		<fieldset disabled={!ready}>
			{
				!ready && (
					<p class="off">
						{import.meta.env.DEV ? 'التحقق الأمني غير مضبوط: عيّن PUBLIC_TURNSTILE_SITE_KEY لتفعيل النموذج.' : 'النموذج غير متاح الآن. حاول لاحقًا.'}
					</p>
				)
			}

			<div class="row">
				<div class="field">
					<label for="c-name">الاسم</label>
					<input id="c-name" name="name" autocomplete="name" required aria-describedby="e-name" />
					<p class="error" id="e-name" data-error="name" role="alert"></p>
				</div>
				<div class="field">
					<label for="c-company">الشركة</label>
					<input id="c-company" name="company" autocomplete="organization" required aria-describedby="e-company" />
					<p class="error" id="e-company" data-error="company" role="alert"></p>
				</div>
			</div>

			<div class="row">
				<div class="field">
					<label for="c-mobile">الجوال</label>
					<div class="mobile">
						<span class="prefix" dir="ltr" aria-hidden="true">+966</span>
						<input id="c-mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel-national" dir="ltr" placeholder="5xxxxxxxx" required aria-describedby="e-mobile" />
					</div>
					<p class="error" id="e-mobile" data-error="mobile" role="alert"></p>
				</div>
				<div class="field">
					<label for="c-email">بريد الشركة</label>
					<input id="c-email" name="email" type="email" inputmode="email" autocomplete="email" dir="ltr" required aria-describedby="e-email" />
					<p class="error" id="e-email" data-error="email" role="alert"></p>
				</div>
			</div>

			<div class="field narrow">
				<label for="c-users">عدد المستخدمين <span class="opt">اختياري</span></label>
				<input id="c-users" name="users" type="text" inputmode="numeric" aria-describedby="e-users" />
				<p class="error" id="e-users" data-error="users" role="alert"></p>
			</div>

			<div class="field">
				<label for="c-message">رسالتك</label>
				<textarea id="c-message" name="message" rows="5" required aria-describedby="e-message"></textarea>
				<p class="error" id="e-message" data-error="message" role="alert"></p>
			</div>

			<div class="field">
				<label class="consent">
					<input type="checkbox" name="consent" aria-describedby="e-consent" />
					<span>أوافق على <a href={localePath('ar', '/privacy')}>سياسة الخصوصية</a></span>
				</label>
				<p class="error" id="e-consent" data-error="consent" role="alert"></p>
			</div>

			<div class="field">
				<div data-turnstile></div>
				<p class="error" data-error="turnstile" role="alert"></p>
			</div>

			<p class="status" data-status role="status" aria-live="polite"></p>
			<button class="button large" type="submit">
				أرسل
				<Icon name="send" size={18} />
			</button>
		</fieldset>
	</form>

	<div class="success" data-success hidden tabindex="-1">
		<span class="ok"><Icon name="check" size={28} strokeWidth={2.4} /></span>
		<h2>وصلتنا رسالتك</h2>
		<p>نتواصل معك بأنفسنا على بريد شركتك أو جوالك.</p>
	</div>
</div>

<script>
	import '../../scripts/contact-form';
</script>

<style>
	.form-card {
		padding: var(--space-8);
		box-shadow: var(--shadow);
	}
	fieldset {
		display: grid;
		gap: var(--space-4);
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	fieldset:disabled {
		opacity: 0.6;
	}
	.off {
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius);
		background: var(--warning-bg);
		color: var(--warning-text);
		font-size: var(--text-sm);
	}
	.row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
	}
	.field {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		min-width: 0;
	}
	.narrow {
		max-width: 16rem;
	}
	label {
		font-weight: 600;
	}
	.opt {
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: 400;
	}
	input:not([type='checkbox']),
	textarea {
		width: 100%;
		min-height: 48px;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		transition: border-color var(--duration) var(--ease);
	}
	textarea {
		resize: vertical;
	}
	input:not([type='checkbox']):focus-visible,
	textarea:focus-visible {
		border-color: var(--accent);
		outline: 2px solid var(--focus);
		outline-offset: 1px;
	}
	[aria-invalid='true'] {
		border-color: var(--warning) !important;
	}
	.mobile {
		display: flex;
		align-items: stretch;
		direction: ltr;
		gap: 0;
	}
	.mobile .prefix {
		display: grid;
		place-items: center;
		padding-inline: 0.9rem;
		border: 1px solid var(--border-strong);
		border-inline-end: 0;
		border-radius: var(--radius) 0 0 var(--radius);
		background: var(--surface-sunken);
		color: var(--text-muted);
	}
	.mobile input {
		border-radius: 0 var(--radius) var(--radius) 0 !important;
	}
	.consent {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-weight: 400;
		cursor: pointer;
	}
	.consent input {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		accent-color: var(--accent);
	}
	.error {
		min-height: 0;
		color: var(--warning-text);
		font-size: var(--text-sm);
	}
	.error:empty {
		display: none;
	}
	.status {
		font-size: var(--text-sm);
	}
	.status:empty {
		display: none;
	}
	.status[data-kind='error'] {
		color: var(--warning-text);
		font-weight: 600;
	}
	.status[data-kind='info'] {
		color: var(--text-muted);
	}
	button[type='submit'] {
		justify-self: start;
	}
	button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.success {
		display: grid;
		justify-items: center;
		gap: var(--space-3);
		padding: var(--space-8) var(--space-4);
		text-align: center;
	}
	.success[hidden] {
		display: none;
	}
	.success:focus-visible {
		outline: none;
	}
	.ok {
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--success-bg);
		color: var(--success-text);
	}
	.success p {
		color: var(--text-muted);
	}
	@media (max-width: 560px) {
		.form-card {
			padding: var(--space-6) var(--space-4);
		}
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
		button[type='submit'] {
			justify-self: stretch;
		}
	}
</style>
