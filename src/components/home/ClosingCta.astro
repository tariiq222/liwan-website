---
// Home closing call to action: an ink block. The Sadu band and the footer that follow
// belong to the layout.
import Mark from '../Mark.astro';
import { loginUrl, registerUrl } from '../../lib/links';

// The defaults are the home page's copy; application pages pass their own.
interface Props {
	title?: string;
	line?: string;
	button?: string;
}

const { title = 'جاهز تجمع شركتك في مكان واحد؟', line = 'جرّب كل التطبيقات 14 يومًا مجانًا.', button = 'جرّب 14 يومًا مجانًا' } = Astro.props;
---

<section class="closing">
	<div class="container inner">
		<div class="mark" data-reveal="fade">
			<Mark size={104} inverted animated />
		</div>
		<h2 data-reveal style="--i: 1">{title}</h2>
		<p data-reveal style="--i: 2">{line}</p>
		<div class="actions" data-reveal style="--i: 3">
			<a class="button large white" href={registerUrl('ar')} data-app-link>{button}</a>
			<a class="button large secondary outline" href={loginUrl('ar')} data-app-link>تسجيل الدخول</a>
		</div>
	</div>
</section>

<style>
	.closing {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
		background: var(--ink);
		color: #fff;
		text-align: center;
	}
	.closing::before,
	.closing::after {
		content: '';
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		filter: blur(70px);
		pointer-events: none;
	}
	.closing::before {
		inset-block-start: -30%;
		inset-inline-start: -10%;
		width: 55%;
		aspect-ratio: 1;
		background: rgb(255 255 255 / 0.1);
	}
	.closing::after {
		inset-block-end: -40%;
		inset-inline-end: -5%;
		width: 50%;
		aspect-ratio: 1;
		background: rgb(255 255 255 / 0.08);
	}
	.inner {
		display: grid;
		justify-items: center;
		gap: var(--space-4);
	}
	.mark {
		margin-bottom: var(--space-2);
	}
	h2 {
		font-size: var(--text-display);
	}
	p {
		max-width: 36rem;
		color: rgb(255 255 255 / 0.88);
		font-size: var(--text-lg);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}
	.button.white:not(.secondary):not(.ghost) {
		background: #fff;
		color: var(--ink);
		box-shadow: 0 10px 28px -10px rgb(20 16 42 / 0.5);
	}
	.button.white:not(.secondary):not(.ghost):hover {
		background: #f4f4f5;
	}
	.button.outline {
		border-color: rgb(255 255 255 / 0.7);
		color: #fff;
	}
	.button.outline:hover {
		border-color: #fff;
		background: rgb(255 255 255 / 0.12);
		color: #fff;
	}

	@media (max-width: 560px) {
		.actions .button {
			flex: 1 1 100%;
		}
	}
</style>
