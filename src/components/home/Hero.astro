---
// Home hero (approved mock .mocks/home-v4.html, 2026-11-08): the sky backdrop, headline, two
// calls to action and a laptop showing the platform's home screen. Application names and colours
// come from src/content/apps and src/lib/app-color.ts; the activity rows are sample data.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { claim } from '../../config/claims';
import { registerUrl } from '../../lib/links';
import { appColorStyle } from '../../lib/app-color';
import { t } from '../../i18n';
import { HOME_APPS } from './home-apps';

const platform = t('ar', 'brand.platform');
const entries = await getCollection('apps', ({ data }) => data.status === 'available');
const bySlug = new Map(entries.map((e) => [e.data.slug, e.data]));
// Side menu follows the catalogue order; Liwan AI sits last, as in the product.
const sideApps = [...entries.map((e) => e.data)].sort((a, b) => a.order - b.order);
const startTiles = ['crm', 'inbox', 'tasks', 'meetings', 'documents', 'ai'].flatMap((s) => (bySlug.has(s) ? [bySlug.get(s)!] : []));
const promoTiles = ['crm', 'inbox', 'tasks', 'ai'].flatMap((s) => (bySlug.has(s) ? [bySlug.get(s)!] : []));
const app = (slug: string) => bySlug.get(slug);
const feed = [
	{ slug: 'inbox', who: 'نورة الشهري', what: 'ردّت على 12 رسالة واتساب' },
	{ slug: 'crm', who: 'شركة الندى', what: 'انتقلت إلى «تفاوض»' },
	{ slug: 'ai', who: app('ai')?.name.ar ?? '', what: 'جاوب سارة عن صفقات الأسبوع' },
].filter((row) => app(row.slug));
const saudi = claim('saudiHosting') === 'available';
---

<section class="hero">
	<div class="container head">
		{
			saudi && (
				<span class="eyebrow-pill" data-reveal>
					<b>استضافة سعودية</b> بياناتك محفوظة داخل المملكة
				</span>
			)
		}
		<h1 data-reveal style="--i: 1">{platform} تجمع أعمالك</h1>
		<p class="lead" data-reveal style="--i: 2">
			كل أقسام شركتك في منصة وحدة، من المبيعات والعملاء إلى الفريق والعمليات.<br />تحوّل رقمي كامل، وتنجز أعمالك من
			مكان واحد.
		</p>
		<div class="cta" data-reveal style="--i: 3">
			<a class="button" href={registerUrl('ar')} data-app-link>جرّبها 14 يومًا مجانًا</a>
			<a class="button secondary" href="#how">شوف كيف تشتغل</a>
		</div>
		<p class="fine" data-reveal style="--i: 3">بلا بطاقة · ألغِ متى ما تبي</p>
	</div>

	<div class="laptop" data-reveal="fade" style="--i: 2" data-laptop aria-hidden="true">
		<div class="lid">
			<div class="screen">
				<aside class="side">
					<div class="me"><span></span> شركة الندى</div>
					<ul>
						<li class="on"><Icon name="search" size={12} /> استكشف</li>
						{
							sideApps.map((a) => (
								<li>
									<Icon name={a.icon} size={12} /> <span>{a.name.ar}</span>
								</li>
							))
						}
					</ul>
				</aside>
				<div class="main">
					<div class="bar">
						<div class="q"><Icon name="search" size={12} />&nbsp; ابحث</div>
						<span class="bb">+ تطبيق</span>
						<span class="pf"></span>
					</div>
					<div class="promo">
						<div>
							<b>التطبيقات التي يحتاجها كل فريق</b>
							<span>ابدأ بإدارة العملاء ورسائلهم، والباقي يجي معها.</span>
						</div>
						<div class="ic">
							{
								promoTiles.map((a) => (
									<span class="tile-ic" style={appColorStyle(a)}>
										<Icon name={a.icon} size={14} />
									</span>
								))
							}
						</div>
					</div>
					<h6>ابدأ من هنا <small>عرض الكل ‹</small></h6>
					<div class="grid">
						{
							startTiles.map((a) => (
								<div class="tile">
									<span class="tile-ic" style={appColorStyle(a)}>
										<Icon name={a.icon} size={14} />
									</span>
									<div>
										<b>{a.name.ar}</b>
										<em>{HOME_APPS[a.slug]?.tag ?? a.headline.ar}</em>
									</div>
									<span class="go">فتح</span>
								</div>
							))
						}
					</div>
					<h6 class="feed-title">نشاط فريقك اليوم <small>الكل ‹</small></h6>
					<div class="grid feed">
						{
							feed.map((row) => {
								const a = app(row.slug)!;
								return (
									<div class="tile">
										<span class="tile-ic" style={appColorStyle(a)}>
											<Icon name={a.icon} size={14} />
										</span>
										<div>
											<b>{row.who}</b>
											<em>{row.what}</em>
										</div>
									</div>
								);
							})
						}
					</div>
				</div>
			</div>
		</div>
		<div class="base"></div>
		<div class="foot"></div>
	</div>
</section>

<script>
	// The laptop starts slightly tilted back and straightens as the visitor scrolls.
	const lap = document.querySelector<HTMLElement>('[data-laptop]');
	if (lap && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const tilt = () => {
			const p = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.6)));
			lap.style.setProperty('--tilt', `${(10 * (1 - p)).toFixed(2)}deg`);
			lap.style.setProperty('--lscale', (0.94 + 0.06 * p).toFixed(3));
		};
		addEventListener('scroll', tilt, { passive: true });
		tilt();
	}
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-top: clamp(3rem, 2rem + 3vw, 4.5rem);
		text-align: center;
		background: var(--hero-sky);
	}
	.head {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
	}
	h1 {
		font-size: clamp(2.375rem, 1rem + 5.4vw, 4.875rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 1.625rem auto 1.375rem;
		max-width: 900px;
	}
	.lead {
		font-size: var(--text-lg);
		color: var(--text-mid);
		max-width: 720px;
	}
	.cta {
		display: flex;
		gap: 14px;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2.125rem;
	}
	.fine {
		margin-top: 14px;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	/* Laptop. The device frame stays dark in both themes; the screen follows the theme. */
	.laptop {
		width: min(1000px, 92%);
		margin: 4.375rem auto -6px;
		position: relative;
		z-index: 1;
		transform-origin: 50% 100%;
	}
	.js .laptop.is-in {
		transform: perspective(1400px) rotateX(var(--tilt, 10deg)) scale(var(--lscale, 0.94));
	}
	.lid {
		background: #161616;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
		padding: 16px 16px 0;
		box-shadow: 0 40px 90px rgb(20 16 42 / 0.22);
	}
	.screen {
		background: var(--surface);
		color: var(--text);
		border-radius: 14px 14px 0 0;
		aspect-ratio: 16 / 8.4;
		overflow: hidden;
		text-align: start;
		display: grid;
		grid-template-columns: 150px 1fr;
		font-size: 11px;
		line-height: 1.5;
	}
	.side {
		background: var(--surface-sunken);
		border-inline-end: 1px solid var(--border);
		padding: 16px 12px;
		color: var(--text-muted);
		min-width: 0;
		overflow: hidden;
	}
	.side .me {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		color: var(--text);
		font-size: 12px;
		margin-bottom: 14px;
	}
	.side .me span {
		width: 22px;
		height: 22px;
		border-radius: 7px;
		background: var(--accent);
	}
	.side ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 7px;
	}
	.side li {
		padding: 5px 8px;
		border-radius: 7px;
		display: flex;
		align-items: center;
		gap: 7px;
		white-space: nowrap;
		min-width: 0;
	}
	.side li span {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.side li.on {
		background: var(--surface);
		color: var(--text);
		font-weight: 500;
		box-shadow: var(--shadow-sm);
	}
	.main {
		padding: 14px 18px;
		min-width: 0;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}
	.bar .q {
		flex: 1;
		height: 26px;
		border-radius: var(--radius-sm);
		background: var(--surface-muted);
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		padding: 0 10px;
		color: var(--text-muted);
	}
	.bb {
		background: var(--accent);
		color: var(--on-accent);
		border-radius: var(--radius-sm);
		padding: 5px 10px;
		font-size: 10px;
		font-weight: 600;
	}
	.pf {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: linear-gradient(135deg, #9d9da8, #14102a);
	}
	.promo {
		border-radius: var(--radius);
		background: var(--surface-muted);
		padding: 14px 16px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 12px;
	}
	.promo b {
		font-size: 14px;
		display: block;
		margin-bottom: 3px;
	}
	.promo span {
		color: var(--text-muted);
	}
	.promo .ic {
		display: flex;
		gap: 6px;
	}
	.tile-ic {
		width: 28px;
		height: 28px;
		border-radius: var(--radius-sm);
		flex: none;
		display: inline-grid;
		place-items: center;
		background: var(--app-tile);
		color: var(--app-on);
	}
	h6 {
		font-size: 12px;
		font-weight: 600;
		margin: 6px 0 8px;
		display: flex;
		justify-content: space-between;
	}
	h6 small {
		color: var(--text-muted);
		font-weight: 400;
	}
	.feed-title {
		margin-top: 14px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
	}
	.tile {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 10px;
		display: flex;
		gap: 8px;
		align-items: flex-start;
		min-width: 0;
	}
	.tile b {
		display: block;
		font-size: 11px;
		font-weight: 600;
	}
	.tile em {
		font-style: normal;
		color: var(--text-muted);
		font-size: 10px;
		display: block;
		line-height: 1.4;
	}
	.tile .go {
		margin-inline-start: auto;
		background: var(--surface-muted);
		border-radius: 6px;
		padding: 2px 7px;
		font-size: 10px;
		font-weight: 600;
		align-self: center;
	}
	.base {
		height: 14px;
		background: linear-gradient(#e9e9ea, #c9c9cc);
		border-radius: 0 0 18px 18px;
		width: 106%;
		margin-inline-start: -3%;
		box-shadow: 0 20px 50px rgb(20 16 42 / 0.22);
	}
	.foot {
		height: 6px;
		background: #b9b9bd;
		border-radius: 0 0 10px 10px;
		width: 30%;
		margin: 0 auto;
	}
	@media (max-width: 760px) {
		.screen {
			grid-template-columns: 1fr;
			aspect-ratio: 16 / 11;
		}
		.side,
		.promo .ic,
		.tile .go {
			display: none;
		}
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.lid {
			padding: 10px 10px 0;
			border-radius: var(--radius-card) var(--radius-card) 0 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.js .laptop.is-in {
			transform: none;
		}
	}
</style>
