---
// Home hero (spec 2A with 1A, simplified by the owner 2026-11-07): eight scattered system cards
// (seven apps plus an AI assistant), joined by cut links, fold into one ring around the LiwanOS
// mark with Liwan AI at its heart; each app's line enters its Sadu triangle through the middle
// of the triangle's base. The loop is driven by src/scripts/hero.ts; under reduced motion it
// shows the Liwan state.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { MARK_ARCHES, MARK_TRIANGLES } from '../../brand/mark';
import { registerUrl } from '../../lib/links';
import { getPricing } from '../../lib/pricing';
import { localePath } from '../../i18n';

// Ring order, clockwise from the top (spec 1A).
const RING = ['crm', 'inbox', 'meetings', 'documents', 'operations', 'tasks', 'chat'] as const;

// Generic system names for the «before» windows: never a competitor's name.
const SYSTEM_NAMES: Record<(typeof RING)[number], string> = {
	crm: 'نظام العملاء',
	inbox: 'منصة الرسائل',
	meetings: 'برنامج الاجتماعات',
	documents: 'تخزين الملفات',
	operations: 'نظام الطلبات',
	tasks: 'أداة المهام',
	chat: 'تطبيق الدردشة',
};

// Scattered card positions (top-left corner, percent of the square scene) and tilt in degrees.
const CARD_W = 30;
const CARD_H = 11;
const SCATTER = [
	[3, 8, -4],
	[36, 2, 3],
	[69, 12, -3],
	[1, 44, 3],
	[69, 48, 4],
	[7, 80, -3],
	[62, 84, -2],
] as const;
const AI_SCATTER = [35, 42, -2] as const;

// Cut links between neighbouring cards: the systems do not talk to each other. Indexes into
// SCATTER; 'ai' is the assistant card.
const CUT_LINKS = [
	[0, 1],
	[1, 2],
	[0, 3],
	[2, 4],
	[3, 'ai'],
	['ai', 4],
	[3, 5],
	[4, 6],
	[5, 6],
] as const;

// Geometry of the Liwan state, in scene percent. The mark (64 units) is drawn 44% wide at the centre.
const CENTER = 50;
const RING_RADIUS = 38;
const NODE = 13;
const AI_NODE = 12;
const MARK_SCALE = 44 / 64;
const MARK_OFFSET = CENTER - 22;
const toScene = (v: number) => +(MARK_OFFSET + v * MARK_SCALE).toFixed(2);

// Each Sadu triangle: the midpoint of its outer base (where app lines land) and its inner tip.
const TRIANGLES = {
	tl: { base: [toScene(12.2), toScene(12.2)], tip: [toScene(18.92), toScene(18.92)] },
	tr: { base: [toScene(51.8), toScene(12.2)], tip: [toScene(45.08), toScene(18.92)] },
	br: { base: [toScene(51.8), toScene(51.8)], tip: [toScene(45.08), toScene(45.08)] },
	bl: { base: [toScene(12.2), toScene(51.8)], tip: [toScene(18.92), toScene(45.08)] },
} as const;

function quadrant(angle: number): keyof typeof TRIANGLES {
	const a = ((angle % 360) + 360) % 360;
	if (a >= 180 && a <= 270) return 'tl';
	if (a > 270) return 'tr';
	if (a <= 90) return 'br';
	return 'bl';
}

const entries = await getCollection('apps');
const bySlug = new Map(entries.map((e) => [e.data.slug, e.data]));

const round = (v: number) => +v.toFixed(2);

// A smooth line between the middle of the triangle's base and the app circle. It leaves the
// triangle along the triangle's own axis and reaches the app heading away from the centre.
// It is drawn from the triangle outward, so the Liwan state grows from the middle.
function lineOut(x: number, y: number, corner: keyof typeof TRIANGLES): string {
	const { base, tip } = TRIANGLES[corner];
	const toCenter = Math.hypot(CENTER - x, CENTER - y);
	const ux = (CENTER - x) / toCenter;
	const uy = (CENTER - y) / toCenter;
	const axisLength = Math.hypot(base[0] - tip[0], base[1] - tip[1]);
	const ax = (base[0] - tip[0]) / axisLength;
	const ay = (base[1] - tip[1]) / axisLength;
	const start = [x + ux * (NODE / 2 + 0.6), y + uy * (NODE / 2 + 0.6)];
	const c1 = [start[0] + ux * 9, start[1] + uy * 9];
	const c2 = [base[0] + ax * 9, base[1] + ay * 9];
	return `M${base[0]} ${base[1]} C${round(c2[0])} ${round(c2[1])} ${round(c1[0])} ${round(c1[1])} ${round(start[0])} ${round(start[1])}`;
}

function cardCenter(index: number | 'ai'): [number, number] {
	const [bx, by] = index === 'ai' ? AI_SCATTER : SCATTER[index];
	return [bx + CARD_W / 2, by + CARD_H / 2];
}

// Each cut link is two dashed halves with a gap in the middle, where a small ✕ sits.
const cuts = CUT_LINKS.map(([from, to]) => {
	const [x1, y1] = cardCenter(from);
	const [x2, y2] = cardCenter(to);
	const mx = (x1 + x2) / 2;
	const my = (y1 + y2) / 2;
	const length = Math.hypot(x2 - x1, y2 - y1);
	const gx = ((x2 - x1) / length) * 2.2;
	const gy = ((y2 - y1) / length) * 2.2;
	return {
		path: `M${round(x1)} ${round(y1)} L${round(mx - gx)} ${round(my - gy)} M${round(mx + gx)} ${round(my + gy)} L${round(x2)} ${round(y2)}`,
		cross: `M${round(mx - 1)} ${round(my - 1)} L${round(mx + 1)} ${round(my + 1)} M${round(mx + 1)} ${round(my - 1)} L${round(mx - 1)} ${round(my + 1)}`,
	};
});

const nodes = RING.map((slug, i) => {
	const app = bySlug.get(slug);
	if (!app) throw new Error(`Hero: app "${slug}" is missing from src/content/apps`);
	const angle = -90 + (i * 360) / RING.length;
	const rad = (angle * Math.PI) / 180;
	const x = round(CENTER + RING_RADIUS * Math.cos(rad));
	const y = round(CENTER + RING_RADIUS * Math.sin(rad));
	const [bx, by, rot] = SCATTER[i];
	return {
		slug,
		name: app.name.ar,
		icon: app.icon,
		system: SYSTEM_NAMES[slug],
		x,
		y,
		labelAbove: y < CENTER,
		line: lineOut(x, y, quadrant(angle)),
		style: `--bx:${bx}%;--by:${by}%;--rot:${rot}deg;--ax:${x - NODE / 2}%;--ay:${y - NODE / 2}%;--i:${i}`,
	};
});

// A short straight line from the edge of the AI circle out to each triangle's tip.
const aiInset = (AI_NODE / 2 + 0.8) / Math.SQRT2;
const tipLines = Object.values(TRIANGLES).map(({ tip }) => {
	const dx = Math.sign(CENTER - tip[0]);
	const dy = Math.sign(CENTER - tip[1]);
	return `M${round(CENTER - dx * aiInset)} ${round(CENTER - dy * aiInset)} L${tip[0]} ${tip[1]}`;
});
const aiStyle = `--bx:${AI_SCATTER[0]}%;--by:${AI_SCATTER[1]}%;--rot:${AI_SCATTER[2]}deg;--ax:${CENTER - AI_NODE / 2}%;--ay:${CENTER - AI_NODE / 2}%;--i:${RING.length}`;
const before = RING.length + 1;

const pricing = await getPricing();
const freeLine = pricing
	? `تطبيقات أساسية مجانية دائمًا، حتى ${pricing.free.users.toLocaleString('ar-SA')} مستخدمين`
	: 'تطبيقات أساسية مجانية دائمًا';

const stats = [
	{ key: 'systems', label: 'أنظمة' },
	{ key: 'logins', label: 'تسجيلات دخول' },
	{ key: 'subscriptions', label: 'اشتراكات' },
];
---

<section class="hero">
	<div class="aurora" aria-hidden="true"></div>
	<div class="container hero-grid">
		<div class="copy">
			<span class="badge free" data-reveal style="--i: 0">{freeLine}</span>
			<h1 data-reveal style="--i: 1">كل أعمالك <span class="text-gradient">بنظام ذكي واحد</span></h1>
			<p class="lead" data-reveal style="--i: 2">تطبيقاتك كلها في ليوان واحد.</p>
			<div class="actions" data-reveal style="--i: 3">
				<a class="button large" href={registerUrl('ar')} data-app-link>ابدأ تجربة ١٤ يومًا</a>
				<a class="button secondary large" href={localePath('ar', '/apps')}>شاهد التطبيقات</a>
			</div>
			<p class="fine" data-reveal style="--i: 4">
				<Icon name="credit-card" size={16} />
				بدون بطاقة ائتمان
			</p>
		</div>

		<figure class="stage" data-reveal="fade" style="--i: 1">
			<div class="scene" data-hero-scene aria-hidden="true">
				<svg class="cut-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
					{
						cuts.map((c) => (
							<g>
								<path class="cut-line" d={c.path} />
								<path class="cut-cross" d={c.cross} />
							</g>
						))
					}
				</svg>
				<svg class="scene-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
					<defs>
						{
							nodes.map((n) => (
								<mask id={`hero-reveal-${n.slug}`} maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
									<path class="reveal reveal-app" d={n.line} pathLength="1" />
								</mask>
							))
						}
						{
							tipLines.map((d, i) => (
								<mask id={`hero-reveal-tip-${i}`} maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
									<path class="reveal reveal-tip" d={d} pathLength="1" />
								</mask>
							))
						}
					</defs>
					<g class="app-lines">
						{nodes.map((n) => <path id={`hero-line-${n.slug}`} d={n.line} mask={`url(#hero-reveal-${n.slug})`} />)}
					</g>
					<g class="tip-lines">
						{tipLines.map((d, i) => <path d={d} mask={`url(#hero-reveal-tip-${i})`} />)}
					</g>
					<g class="pulses">
						{
							nodes.map((n, i) => (
								<circle r="0.8">
									<animateMotion
									dur="2.6s"
									begin={`${(i * 0.37).toFixed(2)}s`}
									repeatCount="indefinite"
									keyPoints="1;0"
									keyTimes="0;1"
									calcMode="linear"
								>
										<mpath href={`#hero-line-${n.slug}`} />
									</animateMotion>
								</circle>
							))
						}
					</g>
					<g class="mark" transform={`translate(${MARK_OFFSET} ${MARK_OFFSET}) scale(${MARK_SCALE})`}>
						<path class="mark-arches-hero" d={MARK_ARCHES} />
						{MARK_TRIANGLES.map((d, i) => <path class="mark-tri-hero" d={d} style={`--t:${i}`} />)}
					</g>
				</svg>

				{
					nodes.map((n) => (
						<div class="node" style={n.style}>
							<div class="win">
								<Icon name={n.icon} class="win-icon" />
								<span class="win-name">{n.system}</span>
							</div>
							<span class="node-icon">
								<Icon name={n.icon} size={22} strokeWidth={2} />
							</span>
						</div>
					))
				}
				<div class="node node-ai" style={aiStyle}>
					<div class="win">
						<Icon name="sparkles" class="win-icon" />
						<span class="win-name">مساعد ذكي</span>
					</div>
					<span class="node-icon">
						<Icon name="sparkles" size={22} strokeWidth={2} />
					</span>
				</div>

				{
					nodes.map((n) => (
						<span
							class:list={['node-label', { above: n.labelAbove }]}
							style={`--lx:${n.x}%;--ly:${n.labelAbove ? n.y - NODE / 2 : n.y + NODE / 2}%`}
						>
							{n.name}
						</span>
					))
				}
			</div>

			<figcaption class="stats" data-hero-stats>
				{
					stats.map((s) => (
						<div class="stat">
							<strong data-count>{before.toLocaleString('ar-SA')}</strong>
							<span>{s.label}</span>
						</div>
					))
				}
			</figcaption>
			<p class="legend">
				<span class="state-before">قبل ليوان: كل نظام بدخوله واشتراكه</span>
				<span class="state-after"><i class="dot-ai"></i>في القلب: ليوان AI، وحوله تطبيقاتك</span>
			</p>
		</figure>
	</div>
</section>

<script>
	import '../../scripts/hero';
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) clamp(3rem, 2rem + 4vw, 6rem);
	}
	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 4vw, 4.5rem);
	}
	.copy {
		display: grid;
		justify-items: start;
		gap: var(--space-6);
	}
	h1 {
		font-size: var(--text-display);
		line-height: 1.18;
		letter-spacing: -0.01em;
	}
	.lead {
		color: var(--text-muted);
		font-size: var(--text-xl);
		max-width: 34ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.fine {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--text-muted);
		font-size: var(--text-sm);
		margin-top: calc(var(--space-3) * -1);
	}

	/* Stage. */
	.stage {
		margin: 0;
		display: grid;
		gap: var(--space-4);
		width: 100%;
		max-width: 560px;
		justify-self: center;
	}
	.scene {
		position: relative;
		aspect-ratio: 1;
		container-type: inline-size;
		/* Apps: sand circles with a lavender ring and icon; Liwan AI is the lavender heart.
		   Connecting lines are a quiet grey so the apps and the mark lead. */
		--node-bg: var(--sand);
		--node-ring: var(--lavender);
		--node-icon: var(--lavender);
		--line: light-dark(#d2cfdb, #3f3a58);
	}
	.scene-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		opacity: 0;
		transition: opacity 400ms var(--ease);
	}
	.is-arrived .scene-svg {
		opacity: 1;
	}
	/* Ring lines are dashed. Each one is revealed by a white mask stroke that draws itself
	   (pathLength 1), so the dashes appear from the centre outward. */
	.app-lines path,
	.tip-lines path {
		fill: none;
		stroke: var(--line);
		stroke-width: 0.45;
		stroke-linecap: round;
		stroke-dasharray: 0.9 1;
	}
	.reveal {
		fill: none;
		stroke: #fff;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	/* «Before»: dashed links between the systems, cut in the middle. */
	.cut-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		transition: opacity 200ms linear;
	}
	.is-fading .cut-svg {
		opacity: 0;
	}
	.cut-line {
		fill: none;
		stroke: var(--border-strong);
		stroke-width: 0.35;
		stroke-dasharray: 1.2 1.2;
		stroke-linecap: round;
		animation: cut-flow 1.6s linear infinite;
	}
	@keyframes cut-flow {
		to {
			stroke-dashoffset: -2.4;
		}
	}
	.cut-cross {
		fill: none;
		stroke: var(--warning);
		stroke-width: 0.45;
		stroke-linecap: round;
	}
	/* The Liwan state grows from the middle, in this order after arrival:
	   AI circle → lines out to the triangle tips → triangles → arches open from the centre →
	   lines out to the apps → each app lights up → names → pulses flow back in. */
	.scene {
		--t-tips: 150ms;
		--t-triangles: 450ms;
		--t-arches: 600ms;
		--t-app-lines: 1000ms;
		--t-apps: 1700ms;
		--t-labels: 1900ms;
		--t-pulses: 2100ms;
	}
	.is-arrived .reveal-tip {
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 350ms var(--ease) var(--t-tips);
	}
	.is-arrived .reveal-app {
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 750ms var(--ease) var(--t-app-lines);
	}
	.pulses circle {
		fill: var(--accent);
		opacity: 0;
		transition: opacity 300ms;
	}
	.is-arrived .pulses circle {
		opacity: 0.9;
		transition-delay: var(--t-pulses);
	}
	/* The arches open outward from the centre (scale and fade), so no draw seam is ever shown. */
	.mark-arches-hero {
		fill: none;
		stroke: var(--accent);
		stroke-width: 3.2;
		stroke-linejoin: round;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(0.45);
	}
	.is-arrived .mark-arches-hero {
		opacity: 1;
		transform: scale(1);
		transition:
			opacity 300ms var(--ease) var(--t-arches),
			transform 650ms var(--ease-spring) var(--t-arches);
	}
	.mark-tri-hero {
		fill: var(--accent);
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(0.3);
	}
	.is-arrived .mark-tri-hero {
		opacity: 1;
		transform: scale(1);
		transition:
			opacity 300ms var(--ease) calc(var(--t-triangles) + var(--t) * 60ms),
			transform 450ms var(--ease-spring) calc(var(--t-triangles) + var(--t) * 60ms);
		animation: tri-pulse 2.8s ease-in-out calc(2.4s + var(--t) * 0.35s) infinite;
	}
	@keyframes tri-pulse {
		50% {
			transform: scale(1.18);
		}
	}

	/* Nodes: a sign-in window before, a circle seat after. */
	.node {
		position: absolute;
		left: var(--bx);
		top: var(--by);
		width: 30%;
		height: 11%;
		rotate: var(--rot);
		border-radius: 1.6cqw;
		background: var(--surface);
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		font-size: 2.6cqw;
		line-height: 1.3;
		transition:
			left 750ms cubic-bezier(0.65, 0, 0.35, 1),
			top 750ms cubic-bezier(0.65, 0, 0.35, 1),
			width 750ms cubic-bezier(0.65, 0, 0.35, 1),
			height 750ms cubic-bezier(0.65, 0, 0.35, 1),
			border-radius 750ms cubic-bezier(0.65, 0, 0.35, 1),
			rotate 750ms cubic-bezier(0.65, 0, 0.35, 1),
			background-color 250ms,
			border-color 250ms,
			box-shadow 250ms;
		transition-delay: calc(var(--i) * 20ms);
		animation: win-float 3.2s ease-in-out infinite;
		animation-delay: calc(var(--i) * -0.4s);
	}
	@keyframes win-float {
		50% {
			translate: 0 -1.5px;
		}
	}
	.win {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding-inline: 0.8em;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		transition: opacity 150ms linear;
	}
	.win :global(.win-icon) {
		flex-shrink: 0;
		width: 1.5em;
		height: 1.5em;
		padding: 0.3em;
		box-sizing: content-box;
		border-radius: 50%;
		background: var(--surface-sunken);
		color: var(--text-muted);
	}
	.node-icon {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--node-icon);
		opacity: 0;
		transform: scale(0.6);
		transition:
			opacity 200ms,
			transform 300ms var(--ease-spring);
	}
	.node-icon :global(svg) {
		width: 46%;
		height: 46%;
	}

	/* Liwan state, in three steps set by hero.ts. */
	.is-fading .win {
		opacity: 0;
	}
	.is-liwan .node {
		left: var(--ax);
		top: var(--ay);
		width: 13%;
		height: 13%;
		border-radius: 50%;
		rotate: 0deg;
		animation: none;
	}
	.is-liwan .node-ai {
		width: 12%;
		height: 12%;
	}
	/* Each app lights up when its line reaches it; the AI circle lights first. */
	.is-arrived .node {
		background: var(--node-bg);
		border-color: var(--node-ring);
		border-width: 0.45cqw;
		box-shadow: 0 8px 20px -8px var(--glow);
		transition-delay: calc(var(--t-apps) + var(--i) * 30ms);
	}
	.is-arrived .node-ai {
		transition-delay: 0ms;
		background: var(--lavender);
		border-color: var(--lavender);
		box-shadow:
			0 0 0 0.9cqw color-mix(in srgb, var(--lavender) 22%, transparent),
			0 0 4cqw var(--glow);
		animation: ai-halo 3s ease-in-out infinite;
	}
	.is-arrived .node-ai .node-icon {
		color: var(--sand);
	}
	@keyframes ai-halo {
		50% {
			box-shadow:
				0 0 0 1.6cqw color-mix(in srgb, var(--lavender) 14%, transparent),
				0 0 6cqw var(--glow);
		}
	}
	.is-arrived .node-icon {
		opacity: 1;
		transform: scale(1);
		transition-delay: calc(var(--t-apps) + var(--i) * 30ms);
	}
	.is-arrived .node-ai .node-icon {
		transition-delay: 0ms;
	}

	.node-label {
		position: absolute;
		left: var(--lx);
		top: var(--ly);
		translate: -50% 0.5cqw;
		font-size: max(11px, 2.7cqw);
		font-weight: 600;
		white-space: nowrap;
		color: var(--text);
		opacity: 0;
