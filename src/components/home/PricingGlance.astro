---
// Home section 6: the free base, a subscription calculator and the trial and refund promise.
// Every figure comes from the public pricing object. Without it the numbers disappear and the
// section offers the free base and "contact us".
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import FreePlanCard from '../FreePlanCard.astro';
import { registerUrl } from '../../lib/links';
import { formatMoney, getPricing } from '../../lib/pricing';
import { daysLabel, formatNumber, storageLabel, usersLabel } from '../../scripts/pricing-format';
import { localePath } from '../../i18n';
import { appColorStyle } from '../../lib/app-color';

const pricing = await getPricing();
const register = registerUrl('ar');
const contact = localePath('ar', '/contact');
const money = (amount: number) => (pricing ? formatMoney('ar', amount, pricing.currency) : '');

const catalog = await getCollection('apps');
const appEntry = (key: string) => catalog.find((entry) => entry.data.featureKey === `${key}.enabled`)?.data;
const appName = (key: string, fallback: string) => appEntry(key)?.name.ar ?? fallback;

const calcJson = pricing ? JSON.stringify(pricing).replace(/</g, '\\u003c') : '';
---

<Section
	id="pricing"
	eyebrow="الأسعار"
	title="سعر واضح، يكبر مع فريقك"
	align="center"
>
	<div class:list={['glance', { 'no-prices': !pricing }]} data-calc={pricing ? '' : undefined}>
		{pricing && <script is:inline type="application/json" data-calc-data set:html={calcJson} />}


		<div class="cols">
			<FreePlanCard pricing={pricing} />

			{
				pricing && (
					<div class="calc" data-reveal style="--i: 2">
						<header class="calc-head">
							<h3>احسب اشتراكك</h3>
							<p>اختر ما يحتاجه فريقك، والسعر يتحدّث مباشرة.</p>
						</header>

						<fieldset class="group">
							<legend>التطبيقات</legend>
							<div class="app-options">
							{pricing.apps.map((app) => (
								<label class="option">
									{appEntry(app.key) && (
										<span class="option-ic" style={appColorStyle(appEntry(app.key)!)}>
											<Icon name={appEntry(app.key)!.icon} size={18} />
										</span>
									)}
									<span class="option-text">
										<span class="option-name">{appName(app.key, app.name_ar)}</span>
										<span class="option-price">
											<span data-price-app={app.key}>{money(app.monthly)}</span> <span data-period-word>شهريًا</span>
										</span>
									</span>
									<input type="checkbox" data-app value={app.key} />
								</label>
							))}
							</div>
						</fieldset>

						<div class="limits-row">
						<div class="group panel">
							<div class="group-head">
								<label for="calc-users">المستخدمون</label>
								<output for="calc-users" data-users-out>
									{usersLabel(pricing.free.users)}
								</output>
							</div>
							<input id="calc-users" type="range" min={pricing.free.users} max={pricing.extra_user.max_users} step="1" value={pricing.free.users} data-users />
							<p class="hint">
								أول {usersLabel(pricing.free.users)} مجانًا، وكل مستخدم إضافي{' '}
								<span data-price-user>{money(pricing.extra_user.monthly)}</span> <span data-period-word>شهريًا</span>
							</p>
							<p class="hint" data-users-max hidden>
								فريق أكبر من هذا؟ <a href={contact}>تواصل معنا</a>
							</p>
						</div>

						<div class="group panel">
							<div class="group-head">
								<span id="calc-storage-label">التخزين</span>
							</div>
							<div class="stepper" role="group" aria-labelledby="calc-storage-label">
								<button type="button" class="step-btn" data-storage-down aria-label="تقليل التخزين">
									<span class="minus" />
								</button>
								<output data-storage-out aria-live="polite">{storageLabel(pricing.free.storage_gb)}</output>
								<button type="button" class="step-btn" data-storage-up aria-label="زيادة التخزين">
									<Icon name="plus" size={18} strokeWidth={2.4} />
								</button>
							</div>
							<p class="hint">
								أول {storageLabel(pricing.free.storage_gb)} مجانًا، ثم كل {storageLabel(pricing.extra_storage.block_gb)}{' '}
								<span data-price-storage>{money(pricing.extra_storage.block_monthly)}</span> <span data-period-word>شهريًا</span>
							</p>
						</div>
						</div>

						<label class="option onboarding">
							<span class="option-ic plain">
								<Icon name="user-plus" size={18} />
							</span>
							<span class="option-text">
								<span class="option-name">إعداد مع فريقنا</span>
								<span class="option-price">{money(pricing.onboarding.one_time)} مرة واحدة</span>
							</span>
							<input type="checkbox" data-onboarding />
						</label>

						<div class="total">
							<div class="billing" role="radiogroup" aria-label="دورة الدفع">
								<label>
									<input type="radio" name="billing" value="monthly" checked />
									<span class="seg">شهري</span>
								</label>
								<label>
									<input type="radio" name="billing" value="annual" />
									<span class="seg">
										سنوي <span class="badge free">شهران مجانًا</span>
									</span>
								</label>
							</div>
							<div class="total-body" aria-live="polite">
							<ul class="breakdown">
								{pricing.apps.map((app) => (
									<li data-line-app={app.key} hidden>
										<span>{appName(app.key, app.name_ar)}</span>
										<span data-amount />
									</li>
								))}
								<li data-line-users hidden>
									<span>
										مستخدمون إضافيون <small data-qty />
									</span>
									<span data-amount />
								</li>
								<li data-line-storage hidden>
									<span>
										تخزين إضافي <small data-qty />
									</span>
									<span data-amount />
								</li>
								<li class="discount" data-line-discount hidden>
									<span>خصم الدفع السنوي (شهران مجانًا)</span>
									<span data-amount />
								</li>
							</ul>
							<p class="total-main">
								<span class="total-label">اشتراكك</span>
								<strong data-total>مجانًا</strong>
								<span data-period data-period-word hidden>
									شهريًا
								</span>
							</p>
							<p class="saving" data-saving hidden>
								توفّر <strong data-saving-amount /> في السنة بالدفع السنوي
							</p>
							<p class="onboarding-line" data-onboarding-line hidden>
								<span>إعداد مع فريقنا، مرة واحدة</span>
								<strong data-onboarding-amount />
							</p>
							</div>
							<a class="button large" href={register} data-app-link>
								جرّب 14 يومًا مجانًا
							</a>
							<p class="total-note">بلا بطاقة · ألغِ متى ما تبي</p>
						</div>
					</div>
				)
			}
		</div>
	</div>

	<div class="band" data-reveal>
		<span class="band-item">
			<Icon name="check" size={18} strokeWidth={2.4} />
			14 يومًا تجربة مجانية بلا بطاقة
		</span>
		{
			pricing && (
				<>
					<Icon name="arrow-left" size={18} class="band-arrow" />
					<span class="band-item">
						<Icon name="shield" size={18} />
						ثم {daysLabel(pricing.refund_days)} ضمان استرداد كامل من أول دفعة
					</span>
				</>
			)
		}
	</div>

	<div class="foot">
		<p>رسائل واتساب التسويقية تحاسبك عليها ميتا مباشرة من حسابك.</p>
		<a class="more" href={localePath('ar', '/pricing')}>
			كل التفاصيل
			<Icon name="arrow-left" size={16} />
		</a>
	</div>
</Section>

<script>
	import '../../scripts/pricing-calculator';
</script>

<style>
	.glance {
		display: grid;
		gap: var(--space-6);
		justify-items: center;
	}
	.cols {
		display: grid;
		width: 100%;
		gap: var(--space-6);
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
		align-items: start;
	}
	.no-prices .cols {
		grid-template-columns: minmax(0, 560px);
		justify-content: center;
	}

	/* Monthly or annual, at the top of the total box. */
	.billing {
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.billing .seg {
		justify-content: center;
		width: 100%;
	}
	.total-body {
		display: grid;
		gap: var(--space-3);
	}
	.billing label {
		position: relative;
	}
	.billing input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.seg {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 40px;
		padding: 0 1.1rem;
		border-radius: var(--radius-sm);
		font-weight: 600;
		cursor: pointer;
		transition:
			background var(--duration) var(--ease),
			color var(--duration) var(--ease);
	}
	.billing input:checked + .seg {
		background: var(--accent);
		color: var(--on-accent);
	}
	.billing input:focus-visible + .seg {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}


	.calc {
		display: grid;
		gap: var(--space-6);
		padding: var(--space-8);
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	.calc h3 {
		font-size: var(--text-xl);
	}
	.group {
		display: grid;
		gap: var(--space-2);
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend,
	.group-head label,
	.group-head > span {
		padding: 0;
		font-weight: 600;
	}
	legend {
		margin-bottom: var(--space-2);
	}
	.group-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
	}
	output {
		color: var(--accent);
		font-weight: 700;
	}
	.hint {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.calc [hidden] {
		display: none;
	}
	/* Custom slider: the native one mis-paints its thumb on first load in right-to-left pages.
	   The track fills from the start side up to the thumb; --fill is set by the calculator. */
	input[type='range'] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 28px;
		margin: 0;
		background: transparent;
		cursor: pointer;
	}
	input[type='range']::-webkit-slider-runnable-track {
		height: 6px;
		border-radius: var(--radius-full);
		background: linear-gradient(to left, var(--accent) var(--fill, 0%), var(--border-strong) var(--fill, 0%));
	}
	input[type='range']::-moz-range-track {
		height: 6px;
		border-radius: var(--radius-full);
		background: linear-gradient(to left, var(--accent) var(--fill, 0%), var(--border-strong) var(--fill, 0%));
	}
	input[type='range']::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 22px;
		height: 22px;
		margin-top: -8px;
		border: 3px solid var(--surface);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 1px 4px rgb(20 16 42 / 0.3);
	}
	input[type='range']::-moz-range-thumb {
		width: 16px;
		height: 16px;
		border: 3px solid var(--surface);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 1px 4px rgb(20 16 42 / 0.3);
	}
	input[type='range']:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 4px;
	}

	.option {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-2);
		padding: var(--space-3) var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		cursor: pointer;
		transition:
			border-color var(--duration) var(--ease),
			background var(--duration) var(--ease);
	}
	.option:hover {
		border-color: var(--border-strong);
	}
	.option:has(input:checked) {
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.option input {
		width: 20px;
		height: 20px;
		accent-color: var(--accent);
	}
	.option-name {
		display: grid;
		font-weight: 600;
	}
	.option-name small {
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: 400;
		line-height: 1.6;
	}
	.option-price {
		color: var(--text-muted);
		font-size: var(--text-sm);
		text-align: end;
	}

	.stepper {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.stepper output {
		min-width: 8rem;
		text-align: center;
		font-size: var(--text-lg);
	}
	.step-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
		transition:
			border-color var(--duration) var(--ease),
			color var(--duration) var(--ease);
	}
	.minus {
		width: 14px;
		height: 2.4px;
		border-radius: 2px;
		background: currentColor;
	}
	.step-btn:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.step-btn:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.total {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
		border-radius: var(--radius);
		background: var(--surface-sunken);
	}
	.total-main {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
	}
	.total-label {
		margin-inline-end: auto;
		color: var(--text-muted);
	}
	.total-main strong {
		font-size: var(--text-3xl);
		line-height: 1.2;
	}
	.breakdown {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.breakdown li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.breakdown small {
		font-size: inherit;
	}
	.saving {
		color: var(--success-text);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.onboarding-line {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px dashed var(--border-strong);
		font-size: var(--text-sm);
	}
	.total .button {
		justify-self: stretch;
		margin-top: var(--space-2);
	}

	.band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-3) var(--space-4);
		margin-top: var(--space-8);
		padding: var(--space-4) var(--space-6);
		border-radius: var(--radius);
		background: var(--accent-soft);
		font-weight: 600;
	}
	.band-item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}
	.band-item :global(svg) {
		color: var(--accent);
	}
	.band :global(.band-arrow) {
		color: var(--accent);
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3) var(--space-6);
		margin-top: var(--space-6);
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-weight: 600;
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}

	/* Wide screens: the base card stays in view beside the taller calculator. */
	@media (min-width: 901px) {
		.cols:not(.no-prices .cols) .base {
			position: sticky;
			top: calc(68px + var(--space-6));
		}
	}
	/* Tablet and phone: one column; the base list flows into as many columns as fit. */
	@media (max-width: 900px) {
		.cols {
			grid-template-columns: minmax(0, 1fr);
		}
		.facts {
			grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
			column-gap: var(--space-6);
			row-gap: var(--space-3);
		}
	}
	@media (max-width: 560px) {
		.calc {
			padding: var(--space-6) var(--space-4);
		}
		.band {
			flex-direction: column;
			align-items: flex-start;
			border-radius: var(--radius-lg);
		}
		.band-item {
			align-items: flex-start;
		}
		.band-item :global(svg) {
			margin-top: 0.3em;
			flex-shrink: 0;
		}
		.band :global(.band-arrow) {
			display: none;
		}
	}
	/* Applications: two per row; the price sits under the name. */
	.app-options {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2);
	}
	.app-options .option {
		grid-template-columns: auto 1fr;
		row-gap: 2px;
		margin-bottom: 0;
	}
	.app-options .option-price {
		grid-column: 2;
	}
	@media (max-width: 560px) {
		.app-options {
			grid-template-columns: 1fr;
		}
	}
	/* Users and storage side by side. */
	.limits-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		align-items: start;
	}
	@media (max-width: 640px) {
		.limits-row {
			grid-template-columns: 1fr;
		}
	}
	/* Calculator polish (2026-11-08): app tiles, paired panels, one check style. */
	.calc {
		gap: var(--space-6);
		padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
		box-shadow: 0 1px 2px rgb(20 16 42 / 0.04), 0 18px 40px -24px rgb(20 16 42 / 0.25);
	}
	.calc-head {
		display: grid;
		gap: 4px;
	}
	.calc-head h3 {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
	}
	.calc-head p {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
	legend,
	.group-head label,
	.group-head > span {
		color: var(--text-muted);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.option {
		grid-template-columns: auto 1fr auto;
		gap: var(--space-3);
		margin-bottom: 0;
		padding: 14px 16px;
		border-radius: var(--radius-card);
	}
	.option:has(input:checked) {
		border-color: var(--accent);
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--accent);
	}
	.option-ic {
		width: 36px;
		height: 36px;
		display: grid;
		place-items: center;
		border-radius: var(--radius);
		background: var(--app-tile);
		color: var(--app-on);
	}
	.option-ic.plain {
		background: var(--surface-muted);
		color: var(--text);
	}
	.option-text {
		display: grid;
		gap: 2px;
		min-width: 0;
	}
	.option-text .option-price {
		text-align: start;
		font-size: var(--text-xs);
	}
	.option input {
		width: 20px;
		height: 20px;
		margin: 0;
	}
	.app-options .option {
		grid-template-columns: auto 1fr auto;
	}
	.app-options .option-price {
		grid-column: auto;
	}

	/* Users and storage: two matching panels. */
	.panel {
		align-content: start;
		gap: var(--space-3);
		padding: 16px;
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
	}
	.panel output {
		color: var(--text);
		font-family: var(--font-display);
		font-size: var(--text-lg);
	}
	.panel .hint {
		font-size: var(--text-xs);
		line-height: 1.6;
	}
	.limits-row {
		gap: var(--space-3);
		align-items: stretch;
	}
	.stepper {
		justify-content: space-between;
		gap: var(--space-2);
		padding: 4px;
		border-radius: var(--radius);
		background: var(--surface-muted);
	}
	.stepper output {
		min-width: 0;
