---
// Home section 7: three steps from sign-up to a working team. A line fills between the steps
// when the list scrolls into view (src/scripts/start-progress.ts). The small mocks are
// illustrations drawn in CSS.
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import { registerUrl } from '../../lib/links';
import { localePath } from '../../i18n';

const register = registerUrl('ar');
const contact = localePath('ar', '/contact');
const CHECKLIST = [
	{ label: 'بيانات الشركة', done: true },
	{ label: 'رقم واتساب', done: true },
	{ label: 'مراحل المبيعات', done: false },
];
const TEAM = ['مدير', 'مبيعات', 'خدمة العملاء'];
---

<Section id="start" tone="sunken" eyebrow="البداية" title="تشتغل على ليوان من أول يوم" lead="ثلاث خطوات في جلسة واحدة، وليوان AI معك في كل خطوة.">
	<ol class="start-steps" data-start>
		<li class="start-step" data-start-step data-reveal style="--i: 0">
			<span class="rail" aria-hidden="true">
				<span class="node"><b>١</b><Icon name="check" size={20} strokeWidth={2.6} /></span>
				<span class="seg"><i></i></span>
			</span>
			<h3>سجّل شركتك</h3>
			<p>اسم شركتك وجوالك، وتبدأ تجربتك فورًا بلا بطاقة.</p>
			<div class="mock" aria-hidden="true">
				<div class="field">
					<span class="label">اسم الشركة</span>
					<span class="input"><span class="line"></span><span class="caret"></span></span>
				</div>
				<div class="field">
					<span class="label">رقم الجوال</span>
					<span class="input"><span class="line short"></span></span>
				</div>
				<span class="mock-button">ابدأ تجربتي</span>
			</div>
		</li>

		<li class="start-step" data-start-step data-reveal style="--i: 1">
			<span class="rail" aria-hidden="true">
				<span class="node"><b>٢</b><Icon name="check" size={20} strokeWidth={2.6} /></span>
				<span class="seg"><i></i></span>
			</span>
			<h3>جهّزها على طريقتك</h3>
			<p>اربط رقم واتساب، واختر ما يناسب نشاطك.</p>
			<div class="mock" aria-hidden="true">
				<ul class="checklist">
					{
						CHECKLIST.map((item) => (
							<li class:list={{ checked: item.done }}>
								<span class="tick">{item.done && <Icon name="check" size={13} strokeWidth={3} />}</span>
								{item.label}
							</li>
						))
					}
				</ul>
				<p class="ai-note">
					<Icon name="sparkles" size={16} />
					جهّزت لك مراحل تناسب نشاطك
				</p>
			</div>
		</li>

		<li class="start-step" data-start-step data-reveal style="--i: 2">
			<span class="rail" aria-hidden="true">
				<span class="node"><b>٣</b><Icon name="check" size={20} strokeWidth={2.6} /></span>
			</span>
			<h3>ادعُ فريقك</h3>
			<p>كل واحد يدخل بصلاحياته، ويبدأ الشغل.</p>
			<div class="mock" aria-hidden="true">
				<ul class="team">
					{
						TEAM.map((role, n) => (
							<li style={`--n: ${n}`}>
								<span class="avatar"></span>
								<span class="line"></span>
								<span class="badge neutral">{role}</span>
							</li>
						))
					}
				</ul>
			</div>
		</li>
	</ol>

	<div class="start-foot" data-reveal>
		<a class="button large" href={register} data-app-link>جرّب ١٤ يومًا مجانًا</a>
		<p>
			تفضّل أن نجهّزه معك؟
			<a href={contact}>
				إعداد مع فريقنا
				<Icon name="arrow-left" size={16} />
			</a>
		</p>
	</div>
</Section>

<script>
	import '../../scripts/start-progress';
</script>

<style>
	.start-steps {
		--node: 48px;
		--col-gap: var(--space-8);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4) var(--col-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.start-step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.start-step h3 {
		margin-top: var(--space-3);
		font-size: var(--text-xl);
	}
	.start-step p {
		color: var(--text-muted);
	}

	.rail {
		display: block;
		height: var(--node);
	}
	.node {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--node);
		height: var(--node);
		border: 2px solid var(--border-strong);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text-muted);
		font-size: var(--text-lg);
		transition:
			background var(--duration-slow) var(--ease),
			border-color var(--duration-slow) var(--ease),
			color var(--duration-slow) var(--ease);
	}
	.node :global(svg) {
		position: absolute;
		opacity: 0;
		transform: scale(0.5);
		transition:
			opacity var(--duration-slow) var(--ease),
			transform var(--duration-slow) var(--ease-spring);
	}
	.node b {
		font-weight: 700;
		transition: opacity var(--duration-slow) var(--ease);
	}
	.is-done .node {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}
	.is-done .node b {
		opacity: 0;
	}
	.is-done .node :global(svg) {
		opacity: 1;
		transform: none;
	}

	.seg {
		position: absolute;
		inset-block-start: calc(var(--node) / 2 - 1px);
		inset-inline-start: calc(var(--node) + 8px);
		inset-inline-end: calc(8px - var(--col-gap));
		height: 2px;
		border-radius: 2px;
		background: var(--border-strong);
	}
	.seg i {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 0;
		border-radius: inherit;
		background: var(--accent);
		transition: width 800ms var(--ease);
	}
	.is-done .seg i {
		width: 100%;
	}

	.mock {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-4);
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow);
		pointer-events: none;
	}
	.line {
		display: block;
		flex: 1;
		height: 8px;
		border-radius: var(--radius-full);
		background: var(--border-strong);
	}
	.line.short {
		max-width: 55%;
	}
	.field {
		display: grid;
		gap: var(--space-1);
	}
	.label {
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: 600;
	}
	.input {
		display: flex;
		align-items: center;
		gap: 3px;
		min-height: 38px;
		padding-inline: var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface-sunken);
	}
	.field:first-child .input {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}
	.field:first-child .line {
		flex: 0 1 62%;
		background: var(--accent);
		opacity: 0.45;
	}
	.caret {
		width: 2px;
		height: 16px;
		background: var(--accent);
		animation: caret 1s steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	.mock-button {
		display: grid;
		place-items: center;
		min-height: 40px;
		border-radius: var(--radius-full);
		background: var(--gradient-accent);
		color: var(--on-accent);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.checklist,
	.team {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.checklist li {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.45rem var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.tick {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border: 2px dashed var(--border-strong);
		border-radius: 50%;
		color: var(--on-accent);
	}
	.checklist .checked .tick {
		border: 0;
		background: var(--success);
	}
	.ai-note {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.5rem var(--space-3);
		border-radius: var(--radius);
		background: var(--accent-soft);
		color: var(--accent);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.team li {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.45rem var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
	}
	.avatar {
		width: 28px;
		height: 28px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--accent-soft);
		box-shadow: inset 0 0 0 1.5px var(--accent);
	}
	.team .line {
		max-width: 5rem;
	}
	.team .badge {
		margin-inline-start: auto;
	}
	.is-done .team li {
		animation: join 500ms var(--ease-spring) backwards;
		animation-delay: calc(var(--n) * 140ms);
	}
	@keyframes join {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.start-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-4) var(--space-8);
		margin-top: var(--space-12);
	}
	.start-foot p {
		color: var(--text-muted);
	}
	.start-foot p a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-weight: 600;
		text-decoration: none;
	}
	.start-foot p a:hover {
		text-decoration: underline;
	}

	@media (max-width: 860px) {
		.start-steps {
			--col-gap: var(--space-8);
			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--col-gap);
		}
		.start-step {
			display: grid;
			grid-template-columns: var(--node) minmax(0, 1fr);
			column-gap: var(--space-4);
			align-items: start;
		}
		.start-step > :not(.rail) {
			grid-column: 2;
		}
		.start-step h3 {
			margin-top: 0;
		}
		.rail {
			grid-column: 1;
			grid-row: 1 / span 3;
			height: auto;
		}
		.seg {
			inset-block-start: calc(var(--node) + 8px);
			inset-block-end: calc(8px - var(--col-gap));
			inset-inline-start: calc(var(--node) / 2 - 1px);
			inset-inline-end: auto;
			width: 2px;
			height: auto;
		}
		.seg i {
			inset-block: auto;
			inset-block-start: 0;
			inset-inline: 0;
			width: auto;
			height: 0;
			transition-property: height;
		}
		.is-done .seg i {
			width: auto;
			height: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.caret,
		.is-done .team li {
			animation: none;
		}
	}
</style>
