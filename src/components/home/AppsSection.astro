---
// Home section 4: the two sold applications as large cards, then the five free applications.
// Names and slugs come from src/content/apps; prices come from the public pricing object.
import { getCollection } from 'astro:content';
import AppCard from '../AppCard.astro';
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import { registerUrl } from '../../lib/links';
import { formatMoney, getPricing } from '../../lib/pricing';
import { localePath } from '../../i18n';

const SOLD = [
	{
		slug: 'crm',
		headline: 'لا تضيع صفقة بعد اليوم',
		audience: 'لفريق المبيعات ومديره',
		benefits: ['كل فرصة بمرحلتها ومسؤولها، أمام عينك', 'تذكير بالمتابعة في وقتها', 'لوحة تُريك أين يقف فريقك'],
	},
	{
		slug: 'inbox',
		headline: 'كل محادثات عملائك في صندوق واحد',
		audience: 'لخدمة العملاء والمبيعات',
		benefits: [
			'واتساب وتيك توك في مكان واحد',
			'فريقك يرد من صندوق مشترك، بلا جوال واحد يتناقلونه',
			'حملات لعملائك الموافقين، وتقرير يريك سرعة رد فريقك',
		],
	},
];
const FREE_SLUGS = ['meetings', 'documents', 'operations', 'tasks', 'chat'];

const apps = await getCollection('apps');
const bySlug = new Map(apps.map((entry) => [entry.data.slug, entry.data]));
const pricing = await getPricing();
const register = registerUrl('ar');

const sold = SOLD.flatMap((card) => {
	const data = bySlug.get(card.slug);
	if (!data) return [];
	const featureKey = data.featureKey?.replace(/\.enabled$/, '');
	const price = pricing?.apps.find((app) => app.key === featureKey);
	return [{ ...card, data, price: price && pricing ? formatMoney('ar', price.monthly, pricing.currency) : undefined }];
});
const free = FREE_SLUGS.flatMap((slug) => bySlug.get(slug) ?? []);
const CRM_STAGES = [
	{ name: 'جديدة', cards: 2 },
	{ name: 'قيد المتابعة', cards: 2 },
	{ name: 'تم الاتفاق', cards: 1 },
];
---

<Section
	id="apps"
	eyebrow="التطبيقات"
	title="ابدأ بما يحتاجه فريقك اليوم، وكبّر متى كبرت"
	lead="كل تطبيق تضيفه ينضم للنظام نفسه: دخول واحد، صلاحيات واحدة، ومساعد واحد يعرفه."
>
	<div class="sold-grid">
		{
			sold.map((card, i) => (
				<div class="sold-wrap" data-reveal style={`--i: ${i}`}>
					<article class="sold gradient-border lift" data-spotlight>
						<div class="mock" aria-hidden="true">
							<div class="mock-bar">
								<i />
								<i />
								<i />
							</div>
							{card.slug === 'crm' ? (
								<div class="kanban">
									{CRM_STAGES.map((stage) => (
										<div class="kanban-col">
											<span class="kanban-head">{stage.name}</span>
											{Array.from({ length: stage.cards }, (_, n) => (
												<div class="kanban-card">
													<span class="line long" />
													<span class="line short" />
													<span class="avatar" />
													{stage.name === 'قيد المتابعة' && n === 0 && <span class="mock-chip">متابعة اليوم</span>}
												</div>
											))}
										</div>
									))}
								</div>
							) : (
								<div class="inbox">
									<ul class="inbox-list">
										<li class="active">
											<span class="avatar" />
											<span class="line long" />
											<span class="mock-chip">واتساب</span>
										</li>
										<li>
											<span class="avatar" />
											<span class="line long" />
											<span class="mock-chip">تيك توك</span>
										</li>
										<li>
											<span class="avatar" />
											<span class="line long" />
											<span class="mock-chip">واتساب</span>
										</li>
									</ul>
									<div class="thread">
										<p class="bubble in">السلام عليكم، أريد الاستفسار عن الخدمة</p>
										<p class="bubble out">أهلًا بك، يسعدنا خدمتك</p>
										<span class="bubble in typing">
											<i />
											<i />
											<i />
										</span>
									</div>
								</div>
							)}
						</div>
						<div class="sold-body">
							<div class="sold-meta">
								<span class="sold-name">
									<Icon name={card.data.icon} size={18} />
									{card.data.name.ar}
								</span>
								<span class="badge neutral">{card.audience}</span>
							</div>
							<h3>{card.headline}</h3>
							<ul class="benefits">
								{card.benefits.map((benefit) => (
									<li>
										<Icon name="check" size={16} strokeWidth={2.4} />
										{benefit}
									</li>
								))}
							</ul>
							<div class="sold-foot">
								{card.price && (
									<p class="price">
										<strong>{card.price}</strong> شهريًا
									</p>
								)}
								<a class="button" href={register} data-app-link>
									جرّبه ١٤ يومًا
								</a>
							</div>
						</div>
					</article>
				</div>
			))
		}
	</div>
</Section>

<Section tone="sand">
	<div class="free-head" data-reveal>
		<h3>ومعك من أول يوم، بلا تكلفة إضافية</h3>
		<p>تطبيقات يحتاجها كل فريق، تأتيك مع أي اشتراك</p>
	</div>
	<div class="free-grid">
		{
			free.map((app, i) => (
				<div class="free-cell">
					<AppCard
						icon={app.icon}
						name={app.name.ar}
						benefit={app.headline.ar}
						status="free"
						href={localePath('ar', `/apps/${app.slug}`)}
						index={i}
					/>
				</div>
			))
		}
	</div>
</Section>

<style>
	.sold-grid {
		display: grid;
		gap: var(--space-6);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
	}
	.sold-wrap {
		display: flex;
	}
	.sold {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding: var(--space-4);
		border-radius: calc(var(--radius-lg) + 4px);
		box-shadow: var(--shadow);
	}

	/* Product illustration: a framed window drawn in CSS. */
	.mock {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface-sunken);
		overflow: hidden;
		min-height: 230px;
		pointer-events: none;
	}
	.mock-bar {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}
	.mock-bar i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--border-strong);
	}
	.line {
		display: block;
		height: 7px;
		border-radius: var(--radius-full);
		background: var(--border-strong);
	}
	.line.long {
		width: 78%;
	}
	.line.short {
		width: 46%;
	}
	.avatar {
		display: block;
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--accent-soft);
		box-shadow: inset 0 0 0 1.5px var(--accent);
	}
	.mock-chip {
		justify-self: start;
		padding: 0 0.55rem;
		border-radius: var(--radius-full);
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.6;
		white-space: nowrap;
	}

	.kanban {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-2);
		padding: var(--space-3);
	}
	.kanban-col {
		display: grid;
		align-content: start;
		gap: var(--space-2);
	}
	.kanban-head {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-muted);
		padding-inline: 2px;
	}
	.kanban-card {
		display: grid;
		gap: 7px;
		grid-template-columns: 1fr auto;
		padding: 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}
	.kanban-card .mock-chip {
		grid-column: 1 / -1;
	}
	.kanban-card .avatar {
		grid-column: 2;
		grid-row: 1 / span 2;
	}

	.inbox {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		min-height: 190px;
	}
	.inbox-list {
		display: grid;
		align-content: start;
		margin: 0;
		padding: 0;
		list-style: none;
		border-inline-end: 1px solid var(--border);
	}
	.inbox-list li {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 4px var(--space-2);
		padding: 10px;
		border-bottom: 1px solid var(--border);
	}
	.inbox-list li.active {
		background: var(--accent-soft);
	}
	.inbox-list .mock-chip {
		grid-column: 2;
	}
	.thread {
		display: grid;
		align-content: end;
		gap: var(--space-2);
		padding: var(--space-3);
	}
	.bubble {
		max-width: 88%;
		margin: 0;
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius);
		font-size: 0.78rem;
		line-height: 1.6;
	}
	.bubble.in {
		justify-self: start;
		background: var(--surface);
		border: 1px solid var(--border);
	}
	.bubble.out {
		justify-self: end;
		background: var(--accent);
		color: var(--on-accent);
	}
	.bubble.typing {
		display: inline-flex;
		gap: 4px;
		width: fit-content;
	}
	.typing i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--border-strong);
		animation: typing 1.2s ease-in-out infinite;
	}
	.typing i:nth-child(2) {
		animation-delay: 0.15s;
	}
	.typing i:nth-child(3) {
		animation-delay: 0.3s;
	}
	@keyframes typing {
		50% {
			transform: translateY(-3px);
			background: var(--accent);
		}
	}

	.sold-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-4);
		padding: 0 var(--space-2) var(--space-2);
	}
	.sold-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
	}
	.sold-name {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--accent);
		font-weight: 600;
	}
	.sold-body h3 {
		font-size: var(--text-2xl);
	}
	.benefits {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.benefits li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
		color: var(--text-muted);
	}
	.benefits :global(svg) {
		flex-shrink: 0;
		margin-top: 0.4em;
		color: var(--success);
	}
	.sold-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-4);
		margin-top: auto;
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}
	.price {
		margin-inline-end: auto;
		color: var(--text-muted);
	}
	.price strong {
		color: var(--text);
		font-size: var(--text-xl);
	}

	.free-head {
		display: grid;
		gap: var(--space-1);
		margin-bottom: var(--space-8);
	}
	.free-head h3 {
		font-size: var(--text-2xl);
	}
	.free-head p {
		color: var(--text-muted);
		font-size: var(--text-lg);
	}
	.free-grid {
		display: grid;
		gap: var(--space-4);
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}
	.free-cell {
		display: flex;
		grid-column: span 2;
	}
	.free-cell > :global(*) {
		flex: 1;
	}
	.free-cell:nth-child(n + 4) {
		grid-column: span 3;
	}

	@media (max-width: 860px) {
		.free-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.free-cell,
		.free-cell:nth-child(n + 4) {
			grid-column: span 1;
		}
		.free-cell:last-child {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 560px) {
		.free-grid {
			grid-template-columns: 1fr;
		}
		.free-cell:last-child {
			grid-column: auto;
		}
		.sold-foot .button {
			flex: 1 1 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.typing i {
			animation: none;
		}
	}
</style>
