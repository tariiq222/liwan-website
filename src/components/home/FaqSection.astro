---
// Home section 8: common questions in one framed column. `<details name="faq">` keeps one answer
// open at a time without a script. The refund period comes from the public pricing object.
import Icon from '../Icon.astro';
import { getPricing } from '../../lib/pricing';
import { daysLabel } from '../../scripts/pricing-format';
import { getCollection } from 'astro:content';
import { localePath } from '../../i18n';

const pricing = await getPricing();
const apps = (await getCollection('apps', ({ data }) => data.status === 'available')).map((e) => e.data).sort((a, b) => a.order - b.order);
const list = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join('، ')} و${names.at(-1)}` : (names[0] ?? ''));
const freeNames = list(apps.filter((a) => a.plan === 'free').map((a) => a.name.ar));
const paidNames = list(apps.filter((a) => a.plan === 'paid').map((a) => a.name.ar));
const refundPeriod = pricing ? daysLabel(pricing.refund_days) : 'فترة الضمان';

const FAQ = [
	{ q: 'هل أحتاج بطاقة ائتمان؟', a: 'لا. تجرّب 14 يومًا كاملة بلا بطاقة.' },
	{ q: 'ماذا بعد التجربة؟', a: 'تبقى على التطبيقات المجانية دائمًا، وبياناتك محفوظة.' },
	{ q: 'هل أسترجع مبلغي؟', a: `نعم، كاملًا خلال ${refundPeriod} من أول دفعة.` },
	{ q: 'وش التطبيقات المجانية ووش المدفوعة؟', a: `المجانية: ${freeNames}. والمدفوعة: ${paidNames}.` },
	{ q: 'كيف أربط واتساب شركتي؟', a: 'من داخل منصة ليوان بخطوات قليلة. ورسائل واتساب التسويقية تحاسبك عليها ميتا مباشرة.' },
];
---

<section class="faq" id="faq">
	<div class="container">
	<h2 class="sec" data-reveal>تسأل، ونجيب</h2>
	<div class="faq-column">
		<div class="faq-frame" data-reveal>
			{
				FAQ.map((item, i) => (
					<details name="faq" open={i === 0}>
						<summary>
							<span>{item.q}</span>
							<Icon name="plus" size={20} />
						</summary>
						<div class="answer">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>

		<div class="faq-help" data-reveal>
			<p>عندك سؤال آخر؟</p>
			<a class="button" href={localePath('ar', '/contact')}>تواصل معنا</a>
		</div>
	</div>
	</div>
</section>

<style>
	.faq {
		padding-block: 2.5rem clamp(4rem, 3rem + 4vw, 6rem);
	}
	.faq-column {
		display: grid;
		gap: var(--space-6);
		max-width: 900px;
		margin: 2.75rem auto 0;
	}
	.faq-frame {
		display: grid;
		gap: 12px;
	}
	details {
		border-radius: var(--radius-card);
		background: var(--surface-muted);
		overflow: hidden;
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 68px;
		padding: var(--space-4) var(--space-6);
		font-size: var(--text-lg);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		transition: background var(--duration) var(--ease);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		background: var(--border);
	}
	summary:focus-visible {
		outline-offset: -3px;
	}
	summary :global(svg) {
		flex-shrink: 0;
		color: var(--accent);
		transition: transform var(--duration) var(--ease);
	}
	details[open] summary :global(svg) {
		transform: rotate(45deg);
	}
	.answer {
		padding: 0 var(--space-6) var(--space-6);
		color: var(--text-mid);
		max-width: 760px;
	}
	details[open] .answer {
		animation: answer-in 350ms var(--ease);
	}
	@keyframes answer-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
	}

	.faq-help {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-6);
		border-radius: var(--radius-card);
		background: var(--surface);
		border: 1px solid var(--border);
		font-weight: 600;
	}

	@media (max-width: 560px) {
		summary {
			padding-inline: var(--space-4);
		}
		.answer {
			padding-inline: var(--space-4);
		}
		.faq-help .button {
			flex: 1 1 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		details[open] .answer {
			animation: none;
		}
	}
</style>
