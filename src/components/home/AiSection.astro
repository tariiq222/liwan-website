---
// Home section 3: «ليوان AI». Capability tabs on the right and an animated demo chat on the left.
// All copy lives here and is embedded as JSON; src/scripts/ai-chat.ts only plays it. The figures
// and names in the examples are illustrative and labelled so under the chat.
// Truth rules: available scenes use only CRM, meetings, operations requests, settings and the
// guide. Only the soon scene «يقترح ردًا ويلخّص المحادثة» touches customer messages.
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import Mark from '../Mark.astro';
import type { IconName } from '../../brand/icons';

type AppKey = 'crm' | 'messages' | 'meetings' | 'operations' | 'documents' | 'settings' | 'guide';

interface Scene {
	status: 'available' | 'soon';
	label: string;
	icon: IconName;
	word: string;
	attach?: { name: string; icon: 'file' | 'sheet' };
	suggestions: { text: string; apps: AppKey[] }[];
	answer: {
		intro: string;
		items: { text: string; meta?: string; app: AppKey; source: string }[];
		foot?: string;
		approve?: boolean;
	};
}

const apps: { key: AppKey; label: string; icon: IconName }[] = [
	{ key: 'crm', label: 'تطبيق إدارة العملاء', icon: 'users' },
	{ key: 'messages', label: 'تطبيق رسائل العملاء', icon: 'message-circle' },
	{ key: 'meetings', label: 'تطبيق الاجتماعات', icon: 'calendar' },
	{ key: 'operations', label: 'تطبيق العمليات', icon: 'clipboard-check' },
	{ key: 'documents', label: 'تطبيق المستندات', icon: 'file-text' },
	{ key: 'settings', label: 'الإعدادات', icon: 'settings' },
	{ key: 'guide', label: 'الدليل', icon: 'book-open' },
];

const ui = {
	assistant: 'ليوان AI',
	soon: 'قريبًا',
	morning: 'صباح الخير',
	evening: 'مساء الخير',
	approve: 'موافق',
	edit: 'تعديل',
};

const scenes: Scene[] = [
	{
		status: 'available',
		label: 'يضبط إعداداتك',
		icon: 'settings',
		word: 'اضبط',
		suggestions: [
			{ text: 'اضبط مراحل المبيعات لتناسب شركتي', apps: ['settings', 'crm'] },
			{ text: 'اضبط مصادر العملاء المحتملين', apps: ['settings', 'crm'] },
			{ text: 'اضبط أسباب خسارة الفرص', apps: ['settings', 'crm'] },
		],
		answer: {
			intro: 'هذا التعديل المقترح، ولن أطبّقه قبل موافقتك:',
			items: [
				{ text: 'عدد المراحل', meta: 'من ٤ إلى ٥ مراحل', app: 'settings', source: 'الإعدادات' },
				{ text: 'مرحلة جديدة: عرض سعر', meta: 'بين «تأهيل» و«تفاوض»', app: 'crm', source: 'تطبيق إدارة العملاء' },
				{ text: 'أثر التعديل', meta: 'الفرص الحالية تبقى في مراحلها', app: 'crm', source: 'تطبيق إدارة العملاء' },
			],
			foot: 'لا أغيّر شيئًا إلا بموافقتك',
			approve: true,
		},
	},
	{
		status: 'available',
		label: 'يبحث في بياناتك',
		icon: 'search',
		word: 'ابحث',
		suggestions: [
			{ text: 'ابحث عن الفرص اللي طلب أصحابها عرض سعر جديد', apps: ['crm'] },
			{ text: 'ابحث عن الفرص اللي ذكر عميلها موعد التجديد', apps: ['crm'] },
			{ text: 'ابحث عن الفرص المتوقفة بدون متابعة', apps: ['crm'] },
		],
		answer: {
			intro: 'لقيت ٣ فرص تذكر عرض سعر جديد:',
			items: [
				{ text: 'توريد أجهزة مكتبية', meta: 'شركة الندى للتجهيزات، مرحلة التفاوض', app: 'crm', source: 'تطبيق إدارة العملاء · فرصة' },
				{ text: 'عقد صيانة سنوي', meta: 'مؤسسة بيان للخدمات، مرحلة التأهيل', app: 'crm', source: 'تطبيق إدارة العملاء · فرصة' },
				{ text: 'تجهيز مستودع جديد', meta: 'مجموعة الخليج للنقل، مرحلة عرض السعر', app: 'crm', source: 'تطبيق إدارة العملاء · فرصة' },
			],
		},
	},
	{
		status: 'available',
		label: 'يجيب ويقارن من كل تطبيقاتك',
		icon: 'chart-column',
		word: 'وش',
		suggestions: [
			{ text: 'وش أهم اللي ينتظرني هذا الأسبوع؟', apps: ['crm', 'meetings', 'operations'] },
			{ text: 'وش الاجتماعات اللي عندي بكرة؟', apps: ['meetings'] },
			{ text: 'وش الطلبات اللي تنتظر موافقتي؟', apps: ['operations'] },
		],
		answer: {
			intro: 'هذا ملخص أسبوعك:',
			items: [
				{ text: '٣ فرص تحتاج متابعة اليوم', meta: 'من لوحة المبيعات', app: 'crm', source: 'تطبيق إدارة العملاء · اللوحة' },
				{ text: 'اجتماعان، أولهما غدًا الساعة ١٠ صباحًا', app: 'meetings', source: 'تطبيق الاجتماعات' },
				{ text: '٤ طلبات بانتظار موافقتك', app: 'operations', source: 'تطبيق العمليات · الطلبات' },
			],
		},
	},
	{
		status: 'available',
		label: 'يعلّمك النظام',
		icon: 'book-open',
		word: 'كيف',
		suggestions: [
			{ text: 'كيف أضيف مرحلة جديدة لمسار المبيعات؟', apps: ['guide', 'crm'] },
			{ text: 'كيف أرتّب اجتماعًا وأدعو الحضور؟', apps: ['guide', 'meetings'] },
			{ text: 'كيف أرفع طلب موافقة جديد؟', apps: ['guide', 'operations'] },
		],
		answer: {
			intro: 'الخطوات من دليل ليوان:',
			items: [
				{ text: 'افتح إعدادات العملاء', meta: 'الخطوة ١', app: 'guide', source: 'الدليل · مراحل المبيعات' },
				{ text: 'اختر مراحل المبيعات ثم أضف مرحلة', meta: 'الخطوة ٢', app: 'guide', source: 'الدليل · مراحل المبيعات' },
				{ text: 'اكتب اسم المرحلة، حدّد موقعها، ثم احفظ', meta: 'الخطوة ٣', app: 'guide', source: 'الدليل · مراحل المبيعات' },
			],
		},
	},
	{
		status: 'soon',
		label: 'يعبّئ النماذج',
		icon: 'file-pen',
		word: 'أنشئ',
		suggestions: [
			{ text: 'أنشئ طلب شراء لعشرة كراسي مكتبية', apps: ['operations'] },
			{ text: 'أنشئ فرصة لشركة الندى بقيمة ٤٥ ألف', apps: ['crm'] },
			{ text: 'أنشئ اجتماعًا مع فريق المبيعات يوم الأحد', apps: ['meetings'] },
		],
		answer: {
			intro: 'جهّزت مسودة طلب الشراء:',
			items: [
				{ text: 'كراسي مكتبية', meta: 'البند', app: 'operations', source: 'تطبيق العمليات · طلب شراء' },
				{ text: '١٠', meta: 'الكمية', app: 'operations', source: 'تطبيق العمليات · طلب شراء' },
				{ text: 'توسعة الفريق', meta: 'المبرر', app: 'operations', source: 'تطبيق العمليات · طلب شراء' },
			],
			foot: 'تبقى مسودة حتى تراجعها وتعتمدها',
			approve: true,
		},
	},
	{
		status: 'soon',
		label: 'يجهّز التقارير',
		icon: 'file-chart',
		word: 'جهّز',
		suggestions: [
			{ text: 'جهّز تقرير المبيعات لهذا الشهر', apps: ['crm'] },
			{ text: 'جهّز ملخص اجتماعات الأسبوع', apps: ['meetings'] },
			{ text: 'جهّز تقريرًا بالطلبات المتأخرة', apps: ['operations'] },
		],
		answer: {
			intro: 'مسودة تقرير المبيعات لهذا الشهر:',
			items: [
				{ text: '٢٨ فرصة جديدة', meta: 'فُتحت هذا الشهر', app: 'crm', source: 'تطبيق إدارة العملاء · اللوحة' },
				{ text: '١١ فرصة أُغلقت بنجاح', meta: 'أُغلقت هذا الشهر', app: 'crm', source: 'تطبيق إدارة العملاء · اللوحة' },
				{ text: 'مرحلة التفاوض', meta: 'أكثر مرحلة تتأخر فيها الفرص', app: 'crm', source: 'تطبيق إدارة العملاء · الفرص' },
			],
			foot: 'تعدّل المسودة قبل أن تشاركها',
		},
	},
	{
		status: 'soon',
		label: 'يقرأ ملفات PDF',
		icon: 'file',
		word: 'اقرأ',
		attach: { name: 'عقد-التوريد.pdf', icon: 'file' },
		suggestions: [
			{ text: 'اقرأ العقد وطلّع لي مواعيد السداد', apps: ['documents'] },
			{ text: 'اقرأ العرض وأنشئ منه فرصة', apps: ['documents', 'crm'] },
			{ text: 'اقرأ المحضر وسجّل قراراته', apps: ['documents', 'meetings'] },
		],
		answer: {
			intro: 'قرأت العقد (٦ صفحات)، وهذه مواعيد السداد:',
			items: [
				{ text: '٣٠٪ عند توقيع العقد', meta: 'الدفعة الأولى', app: 'documents', source: 'تطبيق المستندات · ص ٢' },
				{ text: '٤٠٪ عند التسليم', meta: 'الدفعة الثانية', app: 'documents', source: 'تطبيق المستندات · ص ٣' },
				{ text: '٣٠٪ بعد ٣٠ يومًا من الاستلام', meta: 'الدفعة الأخيرة', app: 'documents', source: 'تطبيق المستندات · ص ٣' },
			],
		},
	},
	{
		status: 'soon',
		label: 'يستورد من Excel',
		icon: 'sheet',
		word: 'استورد',
		attach: { name: 'العملاء.xlsx', icon: 'sheet' },
		suggestions: [
			{ text: 'استورد العملاء من هذا الملف', apps: ['crm'] },
			{ text: 'استورد الفرص المفتوحة من هذا الملف', apps: ['crm'] },
			{ text: 'استورد قائمة الحضور إلى اجتماع الأحد', apps: ['meetings'] },
		],
		answer: {
			intro: 'قرأت الملف (٤٨ صفًا)، وهذا ما سأستورده:',
			items: [
				{ text: 'عمود «اسم الشركة»', meta: 'يُضاف إلى اسم العميل', app: 'crm', source: 'تطبيق إدارة العملاء · الاسم' },
				{ text: 'عمود «الجوال»', meta: 'يُضاف إلى رقم الجوال', app: 'crm', source: 'تطبيق إدارة العملاء · الجوال' },
				{ text: '٣ صفوف مكررة', meta: 'سأتجاوزها', app: 'crm', source: 'تطبيق إدارة العملاء' },
			],
			foot: 'لا أستورد شيئًا قبل موافقتك',
			approve: true,
		},
	},
	{
		status: 'soon',
		label: 'يقترح ردًا ويلخّص المحادثة',
		icon: 'message-square-text',
		word: 'لخّص',
		suggestions: [
			{ text: 'لخّص لي محادثة العميل مع شركة الندى', apps: ['messages'] },
			{ text: 'اقترح ردًا على استفسار السعر', apps: ['messages'] },
			{ text: 'لخّص المحادثات التي تنتظر ردًا', apps: ['messages'] },
		],
		answer: {
			intro: 'ملخص المحادثة، مع رد مقترح:',
			items: [
				{ text: 'يطلب عرض سعر لـ ٥٠ جهازًا', meta: 'ملخص المحادثة', app: 'messages', source: 'تطبيق رسائل العملاء · واتساب' },
				{ text: 'سأل عن موعد التسليم وينتظر ردًا', meta: 'ملخص المحادثة', app: 'messages', source: 'تطبيق رسائل العملاء · واتساب' },
				{
					text: 'أهلًا بك، يسعدنا تجهيز عرض السعر وإرساله لك اليوم.',
					meta: 'رد مقترح',
					app: 'messages',
					source: 'تطبيق رسائل العملاء · واتساب',
				},
			],
			foot: 'ترسل الرد أنت بعد أن تراجعه',
		},
	},
];

const available = scenes.map((scene, index) => ({ scene, index })).filter(({ scene }) => scene.status === 'available');
const soon = scenes.map((scene, index) => ({ scene, index })).filter(({ scene }) => scene.status === 'soon');
const groups = [
	{ id: 'lai-group-available', title: 'متاح الآن', badge: 'available', tabs: available },
	{ id: 'lai-group-soon', title: 'قريبًا', badge: 'soon', tabs: soon },
];

// Icons the script clones into the chat: one per app (keyed by app key), the attachment icons and the check mark.
const scriptIcons: { key: string; name: IconName }[] = [
	{ key: 'check', name: 'check' },
	{ key: 'file', name: 'file' },
	{ key: 'sheet', name: 'sheet' },
	...apps.map((app) => ({ key: app.key, name: app.icon })),
];

const data = JSON.stringify({
	ui,
	apps: apps.map(({ key, label }) => ({ key, label })),
	scenes: scenes.map(({ icon: _icon, ...scene }) => scene),
});
---

<Section
	id="ai"
	eyebrow="ليوان AI"
	title="ذكاء واحد يعرف شركتك كلها"
>
	<div class="lai" data-ai>
		<div class="lai-col" data-reveal>
			{
				groups.map((group) => (
					<div class="lai-group" role="group" aria-labelledby={group.id}>
						<p id={group.id} class="lai-group-title">
							<span class={`badge ${group.badge}`}>{group.title}</span>
						</p>
						<div class="lai-tabs">
							{group.tabs.map(({ scene, index }) => (
								<button
									type="button"
									class:list={['lai-tab', { 'is-soon': scene.status === 'soon' }]}
									data-ai-tab
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									<span class="lai-tab-icon">
										<Icon name={scene.icon} size={18} />
									</span>
									<span class="lai-tab-label">{scene.label}</span>
									{scene.status === 'soon' && <span class="badge soon">{ui.soon}</span>}
									<span class="lai-tab-bar" aria-hidden="true" />
								</button>
							))}
						</div>
					</div>
				))
			}
			<ul class="lai-trust">
				<li>
					<Icon name="lock" size={16} />
					<span>يرى ما تراه فقط</span>
				</li>
				<li>
					<Icon name="check" size={16} />
					<span>لا يغيّر شيئًا إلا بموافقتك</span>
				</li>
			</ul>
		</div>

		<div class="lai-demo" data-reveal style="--i: 1">
			<div class="lai-stage" data-ai-stage>
				<div class="aurora" aria-hidden="true"></div>
				<div class="lai-chat">
					<div class="lai-win" data-ai-win data-status="available" aria-hidden="true">
						<div class="lai-strip">
							{
								apps.map((app) => (
									<span class="lai-chip" data-app={app.key}>
										<Icon name={app.icon} size={14} />
										{app.label}
									</span>
								))
							}
						</div>
						<div class="lai-body" data-ai-body>
							<div class="lai-empty" data-ai-empty>
								<Mark size={56} animated />
								<p class="lai-greeting" data-ai-greeting>{ui.morning}</p>
								<p class="lai-prompt">وش نقدر نسوي لك اليوم؟</p>
							</div>
							<div class="lai-msgs" data-ai-msgs></div>
						</div>
						<div class="lai-dock">
							<div class="lai-sugs" data-ai-sugs></div>
							<div class="lai-field">
								<span class="lai-plus" data-ai-plus><Icon name="plus" size={16} /></span>
								<span class="lai-file" data-ai-file></span>
								<span class="lai-input" data-ai-input data-placeholder="اكتب رسالتك"></span>
								<span class="lai-send"><Icon name="send" size={16} /></span>
							</div>
						</div>
						<svg class="lai-lines" data-ai-lines aria-hidden="true"></svg>
					</div>
				</div>
				<p class="lai-note">أمثلة توضيحية</p>
			</div>
		</div>

		<p class="lai-sr" aria-live="polite" data-ai-live></p>
		<script type="application/json" data-ai-data is:inline set:html={data} />
		<template data-ai-icons>
			{
				scriptIcons.map((entry) => (
					<span data-icon={entry.key}>
						<Icon name={entry.name} size={16} />
					</span>
				))
			}
			<span data-icon="mark"><Mark size={22} /></span>
		</template>
	</div>
</Section>

<script>
	import '../../scripts/ai-chat';
</script>

<style is:global>
	.lai {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-8);
		align-items: stretch;
	}
	@media (min-width: 960px) {
		.lai {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			gap: var(--space-12);
		}
	}
	.lai-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Tabs column. */
	.lai-col {
		display: grid;
		align-content: start;
		gap: var(--space-6);
	}
	.lai-group {
		display: grid;
		gap: var(--space-2);
	}
	.lai-group-title {
		display: flex;
	}
	.lai-tabs {
		display: grid;
		gap: 6px;
	}
	.lai-tab {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		width: 100%;
		min-height: 52px;
		padding: 8px 14px;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.4;
		text-align: start;
		cursor: pointer;
		overflow: hidden;
		transition:
			background var(--duration) var(--ease),
			border-color var(--duration) var(--ease);
	}
	.lai-tab:hover {
		background: var(--surface);
		border-color: var(--border);
	}
	.lai-tab-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--success-bg);
		color: var(--success-text);
	}
	.lai-tab.is-soon .lai-tab-icon {
		background: var(--warning-bg);
		color: var(--warning-text);
		border: 1.5px dashed var(--warning);
	}
	/* A dashed icon marks a capability that is not available yet. */
	.lai-tab.is-soon .icon {
		stroke-dasharray: 2.6 2.2;
	}
	.lai-tab-label {
		min-width: 0;
	}
	.lai-tab[aria-pressed='true'] {
		background: var(--accent-soft);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.lai-tab.is-soon[aria-pressed='true'] {
		background: var(--warning-bg);
		border-color: color-mix(in srgb, var(--warning) 55%, transparent);
	}
	.lai-tab-bar {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 3px;
		pointer-events: none;
	}
	.lai-tab-bar::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
	}
	[dir='rtl'] .lai-tab-bar::after {
		transform-origin: right;
	}
	.lai-tab.is-soon .lai-tab-bar::after {
		background: var(--warning);
	}
	.lai-tab.is-playing .lai-tab-bar::after {
		transform: scaleX(1);
		transition: transform var(--lai-dur, 12s) linear;
	}
	.lai-trust {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		margin: 0;
		padding: 0 var(--space-4);
		list-style: none;
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
