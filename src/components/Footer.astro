---
// Site footer (spec 2I): slim Sadu band, brand column, three link columns, bottom line.
// No email address anywhere: the domain cannot receive mail.
import Mark from './Mark.astro';
import { localePath, otherLocale, t, type DictKey, type Locale } from '../i18n';
import { WHATSAPP_URL } from '../config/site';
import { loginUrl } from '../lib/links';

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const other = otherLocale(locale);
type FooterLink = { href: string; label: string; app?: boolean };
const page = (route: string, key: DictKey): FooterLink => ({ href: localePath(locale, route), label: t(locale, key) });

const columns: { title: DictKey; links: FooterLink[] }[] = [
	{
		title: 'footer.product',
		links: [page('/apps', 'page.apps'), page('/apps/ai', 'footer.ai'), page('/pricing', 'page.pricing')],
	},
	{
		title: 'footer.company',
		links: [
			page('/security', 'footer.security'),
			page('/contact', 'page.contact'),
			{ href: loginUrl(locale), label: t(locale, 'cta.login'), app: true },
		],
	},
	{
		title: 'footer.legal',
		links: [page('/terms', 'page.terms'), page('/privacy', 'page.privacy'), page('/refund', 'page.refund'), page('/dpa', 'page.dpa')],
	},
];
---

<div class="footer-band" aria-hidden="true"><span class="sadu-band"></span></div>
<footer class="site-footer">
	<div class="container grid">
		<div class="brand-col">
			<a class="brand" href={localePath(locale, '/')}>
				<Mark size={32} />
				<span>{t(locale, 'brand.name')}</span>
			</a>
			<p>{t(locale, 'brand.tagline')}</p>
		</div>
		{
			columns.map((col) => (
				<nav aria-label={t(locale, col.title)}>
					<h2>{t(locale, col.title)}</h2>
					<ul>
						{col.links.map((l) => (
							<li>
								<a href={l.href} data-app-link={l.app ? '' : undefined}>
									{l.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="container bottom">
		<span>{t(locale, 'footer.copyright')}</span>
		<div class="bottom-links">
			{WHATSAPP_URL && <a href={WHATSAPP_URL} rel="noopener">{t(locale, 'footer.whatsapp')}</a>}
			<a href={localePath(other, path)} hreflang={other} lang={other}>{t(locale, 'nav.language')}</a>
		</div>
	</div>
</footer>

<style>
	.footer-band {
		background: var(--surface-sunken);
		color: var(--sand-300);
		padding-top: var(--space-2);
	}
	.footer-band .sadu-band {
		height: 22px;
	}
	.site-footer {
		background: var(--surface-sunken);
		padding-block: var(--space-12) var(--space-8);
		font-size: var(--text-sm);
	}
	.grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		gap: var(--space-8);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--text);
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
	}
	.brand-col p {
		margin-top: var(--space-3);
		color: var(--text-muted);
		max-width: 32ch;
	}
	h2 {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--text);
		margin-bottom: var(--space-3);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}
	a {
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border);
		color: var(--text-muted);
	}
	.bottom-links {
		display: flex;
		gap: var(--space-6);
	}
	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.brand-col {
			grid-column: 1 / -1;
		}
	}
</style>
