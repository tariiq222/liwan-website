---
// Internal identity reference: colors, type, buttons, labels, cards and the mark. The site is light only.
// Not linked from the site, kept out of the sitemap and marked noindex.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import { appColorStyle } from '../lib/app-color';
import { t } from '../i18n';

// Values mirror docs/brand.md, the single source for the identity.
const platform = t('ar', 'brand.platform');

const brandColors = [
	{ name: 'حبر ليوان', token: '--ink', hex: '#14102A', role: 'اللون الأساسي: الأزرار الرئيسية والعناوين والأرقام وتطبيقات المجان' },
	{ name: 'حبر عند المرور', token: '--ink-hover', hex: '#2B2545', role: 'الزر الرئيسي عند مرور المؤشر' },
	{ name: 'حبر عند الضغط', token: '--ink-pressed', hex: '#3A3550', role: 'الزر الرئيسي عند الضغط، والنص المتوسط' },
];

const roleColors = [
	{ name: 'الخلفية', token: '--bg' },
	{ name: 'السطح', token: '--surface' },
	{ name: 'سطح رمادي', token: '--surface-muted' },
	{ name: 'النص', token: '--text' },
	{ name: 'نص متوسط', token: '--text-mid' },
	{ name: 'نص ثانوي', token: '--text-muted' },
	{ name: 'الحدود', token: '--border' },
	{ name: 'التمييز', token: '--accent' },
];

// Application colours: free applications share the ink, paid ones keep their own colour.
const apps = (await getCollection('apps', ({ data }) => data.status !== 'hidden')).sort((x, y) => x.data.order - y.data.order);

const typeScale = [
	{ label: 'عرض', display: true, size: '--text-display', weight: 700, ar: 'كل أعمال شركتك في مكان واحد', en: 'Your whole company, one place' },
	{ label: 'عنوان 1', display: true, size: '--text-3xl', weight: 700, ar: 'تطبيقات تتكلم مع بعض', en: 'Apps that talk to each other' },
	{ label: 'عنوان 2', size: '--text-2xl', weight: 700, ar: 'ابدأ مجانًا مع فريقك', en: 'Start free with your team' },
	{ label: 'عنوان 3', size: '--text-xl', weight: 600, ar: 'رسائل عملائك في صندوق واحد', en: 'Every customer message in one inbox' },
	{ label: 'كبير', size: '--text-lg', weight: 400, ar: 'كل تطبيق يقرأ من نفس البيانات، فلا تنسخ شيئًا مرتين.', en: 'Every app reads the same data, so nothing is typed twice.' },
	{ label: 'أساسي', size: '--text-base', weight: 400, ar: 'تابع صفقاتك من أول رسالة حتى آخر ريال، وكل خطوة لها مسؤول وموعد.', en: 'Follow each deal from the first message to the last riyal.' },
	{ label: 'صغير', size: '--text-sm', weight: 400, ar: 'بلا بطاقة ائتمان، والإلغاء في أي وقت.', en: 'No card needed. Cancel any time.' },
];

// Sample cards read their names from src/content/apps, never retyped.
const sampleApps = apps.slice(0, 3).map(({ data }) => ({
	name: data.name.ar,
	line: data.summary.ar,
	badge: data.status === 'soon' ? 'soon' : data.plan === 'free' ? 'free' : 'available',
	icon: data.icon,
	color: appColorStyle(data),
}));
---

<Base locale="ar" title="هوية ليوان" path="/brand-kit/" noindex>
	<div class="kit">
		<section class="intro container">
			<div>
				<span class="eyebrow">مرجع داخلي</span>
				<h1>هوية ليوان</h1>
				<p class="lead">الألوان والخطوط والأزرار والوسوم كما تظهر في الموقع. المرجع المكتوب هو docs/brand.md، وهذه الصفحة تعرضه.</p>
			</div>
		</section>

		<!-- Sample: a hero composed only from the tokens below. -->
		<section class="container">
			<div class="sample-hero" data-replay>
				<div class="aurora" aria-hidden="true"></div>
				<div class="hero-copy">
					<Mark size={64} animated />
					<span class="badge free" data-reveal style="--i: 1">مجاني لأول 3 مستخدمين</span>
					<h2 class="display" data-reveal style="--i: 2">كل أعمال شركتك في مكان واحد وبذكاء واحد</h2>
					<p class="lead" data-reveal style="--i: 3">العملاء والرسائل والمهام والاجتماعات في نظام عربي واحد، يقرأ من بيانات واحدة.</p>
					<div class="actions" data-reveal style="--i: 4">
						<a class="button large" href="#">ابدأ مجانًا</a>
						<a class="button secondary large" href="#">شاهد التطبيقات</a>
					</div>
				</div>
			</div>
			<button type="button" class="button ghost small replay" data-replay-button>إعادة الحركة</button>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الشعار</h2>
				<p>الشكل الرسمي كما هو في المنتج. تحت 24 بكسل يصير الخط أثقل والمعيّن مصمتًا.</p>
			</header>
			<div class="logo-grid">
				<div class="logo-tile on-bg">
					<div class="lockup"><Mark size={44} /><span>{platform}</span></div>
					<small>على الخلفية</small>
				</div>
				<div class="logo-tile on-ink">
					<div class="lockup"><Mark size={44} inverted /><span>{platform}</span></div>
					<small>على الحبر</small>
				</div>
				<div class="logo-tile on-sky">
					<div class="lockup"><Mark size={44} /><span>{platform}</span></div>
					<small>على خلفية السماء</small>
				</div>
			</div>
			<div class="sizes">
				{[16, 20, 24, 32, 48, 72, 112].map((s) => (
					<figure>
						<Mark size={s} />
						<figcaption>{s}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الألوان</h2>
				<p>الحبر هو لون الهوية، ومعه رماديات محايدة. البنفسجي والرملي لم يعودا من الهوية.</p>
			</header>
			<div class="swatches">
				{brandColors.map((c) => (
					<div class="swatch">
						<span class="chip" style={`background: var(${c.token})`}></span>
						<strong>{c.name}</strong>
						<code dir="ltr">{c.hex}</code>
						<small>{c.role}</small>
					</div>
				))}
			</div>
			<h3 class="sub">ألوان التطبيقات</h3>
			<p class="sub-note">لكل تطبيق لون واحد ثابت لأيقونته وزره. تطبيقات المجان تأخذ لون الحبر.</p>
			<div class="app-swatches">
				{apps.map(({ data }) => (
					<div class="app-swatch" style={appColorStyle(data)}>
						<span class="app-tile"><Icon name={data.icon} size={22} /></span>
						<small>{data.name.ar}</small>
					</div>
				))}
			</div>
			<h3 class="sub">أدوار الألوان</h3>
			<div class="roles">
				{roleColors.map((c) => (
					<div class="role">
						<span class="chip small" style={`background: var(${c.token})`}></span>
						<span class="role-text">
							<span>{c.name}</span>
							<code dir="ltr">{c.token}</code>
						</span>
					</div>
				))}
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الخط</h2>
				<p>IBM Plex Sans Arabic لكل النصوص، وIBM Plex Sans للإنجليزي. Rubik للعناوين الكبيرة والأرقام الكبيرة فقط، ولا يُستخدم في الأزرار أو القوائم أو الجداول.</p>
			</header>
			<div class="type-list">
				{typeScale.map((t) => (
					<div class="type-row">
						<div class="type-meta">
							<strong>{t.label}</strong>
							<code dir="ltr">{t.size}</code>
						</div>
						<div class="type-samples">
							<p style={`font-size: var(${t.size}); font-weight: ${t.weight}; line-height: 1.35;${t.display ? ' font-family: var(--font-display)' : ''}`}>{t.ar}</p>
							<p lang="en" dir="ltr" class="en" style={`font-size: var(${t.size}); font-weight: ${t.weight}; line-height: 1.35;${t.display ? ' font-family: var(--font-display)' : ''}`}>{t.en}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الأزرار والوسوم</h2>
				<p>زر رئيسي واحد في كل قسم. الحالات بألوانها المعروفة: الأخضر لـ«مجاني» و«متاح الآن»، والكهرماني لـ«قريبًا». الزر الرئيسي حبر مصمت، والثانوي أبيض بإطار حبر.</p>
			</header>
			<div class="row">
				<a class="button large" href="#">ابدأ مجانًا</a>
				<a class="button" href="#">ابدأ مجانًا</a>
				<a class="button secondary" href="#">شاهد التطبيقات</a>
				<a class="button ghost" href="#">تسجيل الدخول</a>
				<a class="button small" href="#">جرّبه</a>
			</div>
			<div class="row">
				<span class="badge free">مجاني</span>
				<span class="badge soon">قريبًا</span>
				<span class="badge neutral">ليوان AI</span>
				<span class="badge available">متاح الآن</span>
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>البطاقات</h2>
				<p>بطاقة التطبيق: اسم، سطر واحد يقول الفائدة، ووسم الحالة.</p>
			</header>
			<div class="cards">
				{sampleApps.map((a) => (
					<article class="card app-card">
						<div class="app-top">
							<span class="app-icon" style={a.color}><Icon name={a.icon} size={20} /></span>
							<span class={`badge ${a.badge}`}>{a.badge === 'free' ? 'مجاني' : a.badge === 'soon' ? 'قريبًا' : 'متاح الآن'}</span>
						</div>
						<h3>{a.name}</h3>
						<p>{a.line}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>خلفية السماء</h2>
				<p>سماء فاتحة تتلاشى إلى الأبيض، خلف أعلى الصفحة الرئيسية وصفحات التطبيقات والأسعار. العنوان والأزرار فوقها بلون الحبر. الهوية ما فيها تدرجات غير هذه.</p>
			</header>
			<div class="gradients">
				<figure>
					<div class="g-tile" style="background: var(--hero-sky)"></div>
					<figcaption><strong>سماء الصفحة</strong><code dir="ltr">--hero-sky</code></figcaption>
				</figure>
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الحركة</h2>
				<p>حركة هادئة تخدم القراءة: العناصر تظهر بالتتابع عند الوصول إليها، والشعار يُرسم، والبطاقات تتجاوب مع المؤشر. تتوقف كلها عند من أوقف الحركة في جهازه.</p>
			</header>
			<div class="motion-grid" data-replay>
				<div class="card motion-card">
					<Mark size={120} animated />
					<strong>رسم الشعار</strong>
					<small>الأقواس تُرسم، ثم المثلثات، ثم المعيّن</small>
				</div>
				<div class="card motion-card">
					<div class="stagger">
						{['العملاء', 'الرسائل', 'المهام', 'الاجتماعات'].map((n, i) => (
							<span class="stagger-item" data-reveal="scale" style={`--i: ${i}`}>{n}</span>
						))}
					</div>
					<strong>ظهور متتابع</strong>
					<small>كل عنصر يتأخر قليلًا عن الذي قبله</small>
				</div>
			</div>
			<button type="button" class="button ghost small replay" data-replay-button>إعادة الحركة</button>
			<h3 class="sub">بطاقات تتجاوب مع المؤشر</h3>
			<div class="cards">
				{sampleApps.map((a, i) => (
					<article class="card app-card lift" data-spotlight data-reveal style={`--i: ${i}`}>
						<div class="app-top">
							<span class="app-icon" style={a.color}><Icon name={a.icon} size={20} /></span>
							<span class={`badge ${a.badge}`}>{a.badge === 'free' ? 'مجاني' : a.badge === 'soon' ? 'قريبًا' : 'متاح الآن'}</span>
						</div>
						<h3>{a.name}</h3>
						<p>{a.line}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container block">
			<header class="block-head">
				<h2>الشكل والعمق</h2>
				<p>نظام زوايا واحد بأربعة مقاسات: 8 للقطع الداخلية، 12 للأزرار والحقول، 18 للبطاقات، 24 للأسطح الكبيرة.</p>
			</header>
			<div class="depth">
				<div class="depth-tile" style="border-radius: var(--radius-sm); box-shadow: var(--shadow-sm)">8</div>
				<div class="depth-tile" style="border-radius: var(--radius); box-shadow: var(--shadow-sm)">12</div>
				<div class="depth-tile" style="border-radius: var(--radius-card); box-shadow: var(--shadow)">18</div>
				<div class="depth-tile" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)">24</div>
			</div>
		</section>
	</div>
</Base>

<script>
	import { observeReveal } from '../scripts/motion';

	// Replay: hide the entrances of the section above the button again, then let them play.
	document.querySelectorAll<HTMLButtonElement>('[data-replay-button]').forEach((button) =>
		button.addEventListener('click', () => {
			const target = button.previousElementSibling?.matches('[data-replay]')
				? button.previousElementSibling
				: button.parentElement?.querySelector('[data-replay]');
			if (!target) return;
			target.querySelectorAll('.is-in').forEach((el) => el.classList.remove('is-in'));
			requestAnimationFrame(() => requestAnimationFrame(() => observeReveal(target)));
		}),
	);

</script>

<style>
	.kit {
		padding-block: var(--space-12) var(--space-24);
		display: grid;
		gap: var(--space-16);
	}
	.intro {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6);
	}
	.intro h1 {
		font-size: var(--text-3xl);
		margin-block: var(--space-2);
	}
	.lead {
		color: var(--text-muted);
		font-size: var(--text-lg);
		max-width: 60ch;
	}

	/* Sample hero. */
	.sample-hero {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg);
		border: 1px solid var(--border);
		padding: var(--space-16) var(--gutter) var(--space-24);
		text-align: center;
	}
	.hero-copy {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: var(--space-6);
		max-width: 760px;
		margin-inline: auto;
	}
	.display {
		font-size: var(--text-display);
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
	}

	/* Blocks. */
	.block {
		display: grid;
		gap: var(--space-8);
	}
	.block-head {
		display: grid;
		gap: var(--space-2);
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--border);
	}
	.block-head h2 {
		font-size: var(--text-2xl);
	}
	.block-head p {
		color: var(--text-muted);
	}
	.sub {
		font-size: var(--text-lg);
	}
	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: var(--text-xs);
		color: var(--text-muted);
	}
	small {
		color: var(--text-muted);
		font-size: var(--text-xs);
	}

	/* Logo. */
	.logo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-4);
	}
	.logo-tile {
		display: grid;
		gap: var(--space-4);
		justify-items: center;
		padding: var(--space-12) var(--space-4) var(--space-4);
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
	}
	.lockup {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: 2rem;
		font-weight: 700;
	}
	.on-bg {
		background: var(--surface);
	}
	.on-ink {
		background: var(--ink);
		color: #fff;
	}
	.on-sky {
		background: var(--hero-sky);
		color: var(--ink);
	}
	.on-ink small {
		color: rgb(255 255 255 / 0.7);
	}
	.on-sky small {
		color: var(--text-muted);
	}
	.sizes {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: var(--space-8);
	}
	.sizes figure {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: var(--space-2);
	}
	figcaption {
		font-size: var(--text-xs);
		color: var(--text-muted);
	}

	/* Colors. */
	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-4);
	}
	.swatch {
		display: grid;
		gap: var(--space-1);
	}
	.chip {
		display: block;
		height: 96px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		margin-bottom: var(--space-2);
	}
	.chip.small {
		height: 40px;
		width: 40px;
		margin: 0;
		border-radius: var(--radius-full);
		flex-shrink: 0;
	}
	.roles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: var(--space-4);
	}
	.role {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.role-text {
		display: grid;
		line-height: 1.4;
	}
	.role-text code,
	.swatch code {
		justify-self: start;
	}

	/* Type. */
	.type-list {
		display: grid;
	}
	.type-row {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: var(--space-6);
		padding-block: var(--space-6);
		border-bottom: 1px dashed var(--border);
	}
	.type-meta {
		display: grid;
		align-content: start;
		gap: var(--space-1);
	}
	.type-samples {
		display: grid;
		gap: var(--space-2);
		min-width: 0;
	}
	.type-samples .en {
		font-family: var(--font-en);
		color: var(--text-muted);
		text-align: start;
	}

	/* Buttons and labels. */
	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
	}

	/* Cards. */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-4);
	}
	.app-card {
		display: grid;
		gap: var(--space-2);
		transition:
			transform var(--duration) var(--ease),
			box-shadow var(--duration) var(--ease);
	}
	.app-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow);
	}
	.app-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}
	.app-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: var(--radius);
		background: var(--app-tile, var(--app-free));
		color: var(--app-on, var(--app-free-on));
	}
	.app-card h3 {
		font-size: var(--text-lg);
	}
	.app-card p {
		color: var(--text-muted);
	}


	.replay {
		justify-self: start;
		margin-top: calc(var(--space-4) * -1);
	}

	/* Gradients. */
	.gradients {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-4);
	}
	.gradients figure {
		margin: 0;
		display: grid;
		gap: var(--space-2);
	}
	.gradients figcaption {
		display: grid;
		line-height: 1.5;
		color: var(--text);
		font-size: var(--text-sm);
	}
	.gradients code {
