---
// Home page, in the order of the approved mock (.mocks/home-v4.html, 2026-11-08).
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import AppsRail from '../components/home/AppsRail.astro';
import PickStrip from '../components/home/PickStrip.astro';
import PricingGlance from '../components/home/PricingGlance.astro';
import HowSteps from '../components/home/HowSteps.astro';
import UseCases from '../components/home/UseCases.astro';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import FaqSection from '../components/home/FaqSection.astro';
import { t } from '../i18n';
---

<Base locale="ar" title={t('ar', 'home.title')} path="/">
	<Hero />
	<AppsRail />
	<PickStrip />
	<PricingGlance />
	<HowSteps />
	<UseCases />
	<FeatureGrid />
	<FaqSection />
</Base>
